<div id="splash-screen" class="splash-screen" style="display:none;">
  <svg viewBox="0 0 300 220" width="200" height="147" xmlns="http://www.w3.org/2000/svg">
    <!-- Sfondo minimal -->
    <rect width="300" height="220" fill="transparent" />

    <!-- Forma squircle principale (base) -->
    <rect id="splash-base" x="50" y="140" width="200" height="50" rx="20" fill="#ddd" opacity="0.3" />

    <!-- Cane minimal (solo silhouette) -->
    <g id="splash-dog" transform="translate(80,130)">
      <!-- Corpo squircle -->
      <rect x="20" y="5" width="50" height="28" rx="14" fill="#333" />
      <!-- Testa squircle -->
      <rect x="75" y="0" width="24" height="22" rx="11" fill="#333" />
      <!-- Orecchio -->
      <rect x="80" y="-4" width="8" height="12" rx="4" fill="#555" />
      <!-- Coda (squircle allungato) -->
      <rect id="splash-tail" x="2" y="8" width="18" height="6" rx="3" fill="#444" />
      <!-- Zampa posteriore alzata -->
      <rect id="splash-leg" x="40" y="18" width="8" height="14" rx="4" fill="#333" transform-origin="44px 24px" />
      <!-- Zampa anteriore -->
      <rect x="62" y="28" width="7" height="10" rx="3.5" fill="#444" />
      <rect x="72" y="28" width="7" height="10" rx="3.5" fill="#444" />
    </g>

    <!-- Pozzetto (squircle piatto) -->
    <rect id="splash-puddle" x="170" y="168" width="0" height="0" rx="6" fill="#999" opacity="0.6" />

    <!-- Goccia minimal (squircle) -->
    <rect id="splash-drop" x="180" y="135" width="6" height="10" rx="3" fill="#888" opacity="0" />

    <!-- Linea di connessione (asta sottile) -->
    <rect x="130" y="10" width="2" height="160" rx="1" fill="#ccc" opacity="0.5" />
    <circle cx="131" cy="10" r="10" fill="#ddd" opacity="0.4" />
  </svg>

  <div class="splash-text">CiulloTracker</div>
</div>

<style>
  .splash-screen {
    position: fixed;
    inset: 0;
    z-index: 9999;
    background: #f9f9f9;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    animation: splash-fadeout 0.6s ease forwards;
    animation-delay: 3.4s;
  }

  .splash-text {
    margin-top: 16px;
    font-weight: 300;
    font-size: 1.3rem;
    letter-spacing: 4px;
    color: #222;
    opacity: 0;
    animation: splash-text-in 0.8s ease forwards;
    animation-delay: 0.6s;
  }

  /* ANIMAZIONI FLUIDE E MINIMAL */

  #splash-leg {
    animation: leg-lift 3s ease-in-out;
  }

  #splash-tail {
    animation: tail-sway 1.2s ease-in-out infinite;
  }

  #splash-drop {
    animation: drop-fall 3s ease-in-out;
  }

  #splash-puddle {
    animation: puddle-grow 3s ease forwards;
  }

  #splash-base {
    animation: base-pulse 3s ease-in-out;
  }

  /* KEYFRAMES */

  @keyframes splash-text-in {
    0% { opacity: 0; transform: translateY(8px); }
    100% { opacity: 1; transform: translateY(0); }
  }

  @keyframes leg-lift {
    0% { transform: rotate(0deg); }
    10% { transform: rotate(0deg); }
    35% { transform: rotate(-50deg); }
    80% { transform: rotate(-50deg); }
    100% { transform: rotate(0deg); }
  }

  @keyframes tail-sway {
    0% { transform: rotate(0deg); transform-origin: 2px 11px; }
    50% { transform: rotate(20deg); transform-origin: 2px 11px; }
    100% { transform: rotate(0deg); transform-origin: 2px 11px; }
  }

  @keyframes drop-fall {
    0% { opacity: 0; transform: translateY(-10px); }
    15% { opacity: 0; }
    30% { opacity: 1; transform: translateY(0); }
    70% { opacity: 1; transform: translateY(20px); }
    85% { opacity: 0.5; transform: translateY(30px); }
    100% { opacity: 0; transform: translateY(35px); }
  }

  @keyframes puddle-grow {
    0% { width: 0; height: 0; opacity: 0.6; }
    20% { width: 0; height: 0; }
    50% { width: 30px; height: 8px; }
    80% { width: 38px; height: 10px; }
    100% { width: 40px; height: 10px; }
  }

  @keyframes base-pulse {
    0% { opacity: 0.3; transform: scaleX(1); }
    30% { opacity: 0.5; transform: scaleX(0.95); }
    70% { opacity: 0.5; transform: scaleX(0.95); }
    100% { opacity: 0.3; transform: scaleX(1); }
  }

  @keyframes splash-fadeout {
    0% { opacity: 1; }
    100% { opacity: 0; visibility: hidden; pointer-events: none; }
  }
</style>

<script>
  (function () {
    try {
      if (!localStorage.getItem('hbt-splash-seen')) {
        document.getElementById('splash-screen').style.display = 'flex';
        localStorage.setItem('hbt-splash-seen', '1');
      }
    } catch (e) {
      // localStorage non disponibile: nessuna splash
    }
  })();
</script>
