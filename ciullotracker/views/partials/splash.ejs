    <path d="M0,0 L0,800 L80,800 Q130,720 70,660 Q160,610 110,510 Q180,460 130,360 Q200,310 140,210 Q210,160 150,60 Q190,30 140,0 Z" fill="#344e41"/>
    <path d="M0,100 Q80,120 120,80 Q90,130 140,160 Q70,170 50,210 Q100,200 120,240 Q60,260 40,310 L0,350 Z" fill="#2b4634"/>
