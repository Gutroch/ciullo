<div id="splash-screen" class="splash-screen">

  <!-- Foglie singole che compaiono -->
  <div class="leaves" aria-hidden="true">
    <svg class="leaf leaf-1" viewBox="0 0 40 60"><path d="M20,58 C20,40 5,30 3,10 C22,14 33,28 33,45 C33,52 27,58 20,58 Z"/></svg>
    <svg class="leaf leaf-2" viewBox="0 0 40 60"><path d="M20,58 C20,40 5,30 3,10 C22,14 33,28 33,45 C33,52 27,58 20,58 Z"/></svg>
    <svg class="leaf leaf-3" viewBox="0 0 40 60"><path d="M20,58 C20,40 5,30 3,10 C22,14 33,28 33,45 C33,52 27,58 20,58 Z"/></svg>
    <svg class="leaf leaf-4" viewBox="0 0 40 60"><path d="M20,58 C20,40 5,30 3,10 C22,14 33,28 33,45 C33,52 27,58 20,58 Z"/></svg>
    <svg class="leaf leaf-5" viewBox="0 0 40 60"><path d="M20,58 C20,40 5,30 3,10 C22,14 33,28 33,45 C33,52 27,58 20,58 Z"/></svg>
    <svg class="leaf leaf-6" viewBox="0 0 40 60"><path d="M20,58 C20,40 5,30 3,10 C22,14 33,28 33,45 C33,52 27,58 20,58 Z"/></svg>
    <svg class="leaf leaf-7" viewBox="0 0 40 60"><path d="M20,58 C20,40 5,30 3,10 C22,14 33,28 33,45 C33,52 27,58 20,58 Z"/></svg>
    <svg class="leaf leaf-8" viewBox="0 0 40 60"><path d="M20,58 C20,40 5,30 3,10 C22,14 33,28 33,45 C33,52 27,58 20,58 Z"/></svg>
  </div>

  <!-- Contenuto Centrale -->
  <div class="hero">
    <div class="typing-wrapper">
      <h1 class="typing-line typing-line-1" aria-label="CIULLO">CIULLO</h1>
      <h1 class="typing-line typing-line-2" aria-label="TRACKER">TRACKER</h1>
    </div>
    <div class="splash-tagline">Il budget di famiglia, cresce con te</div>
  </div>

  <!-- Pulsante Salta -->
  <button class="splash-skip" id="splash-skip" aria-label="Salta introduzione">skip ›</button>
</div>

<style>
  :root {
    --cream: #ccd5ae;
    --sage: #588157;
    --forest: #344e41;
    --deep: #2b4634;
    --ink: #01472e;
  }

  .splash-screen {
    position: fixed;
    inset: 0;
    z-index: 9999;
    background: var(--cream);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    padding: env(safe-area-inset-top) env(safe-area-inset-right) env(safe-area-inset-bottom) env(safe-area-inset-left);
  }

  /* --- Foglie che compaiono --- */
  .leaves {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
  }

  .leaf {
    position: absolute;
    width: 48px;
    height: auto;
    opacity: 0;
    transform: translateY(-14px) scale(0.7) rotate(var(--r, 0deg));
    animation: leaf-in 0.7s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @keyframes leaf-in {
    to { opacity: 1; transform: translateY(0) scale(1) rotate(var(--r, 0deg)); }
  }

  .leaf-1 { top: 6%;  left: 7%;  width: 44px; --r: -18deg; fill: var(--forest); animation-delay: 0.2s; }
  .leaf-2 { top: 9%;  left: 16%; width: 30px; --r: 10deg;  fill: var(--sage);   animation-delay: 0.5s; }
  .leaf-3 { top: 5%;  right: 9%; width: 50px; --r: 22deg;  fill: var(--deep);   animation-delay: 0.35s; }
  .leaf-4 { top: 12%; right: 18%;width: 28px; --r: -12deg; fill: var(--sage);   animation-delay: 0.65s; }
  .leaf-5 { bottom: 7%; left: 8%; width: 46px; --r: 16deg;  fill: var(--forest); animation-delay: 0.8s; }
  .leaf-6 { bottom: 11%;left: 19%;width: 26px; --r: -8deg;  fill: var(--sage);   animation-delay: 1.05s; }
  .leaf-7 { bottom: 6%; right: 8%; width: 48px; --r: -20deg; fill: var(--deep);  animation-delay: 0.95s; }
  .leaf-8 { bottom: 13%;right: 19%;width: 28px; --r: 14deg;  fill: var(--sage);  animation-delay: 1.15s; }

  /* --- Hero centrale --- */
  .hero {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    max-width: 92vw;
  }

  .typing-wrapper {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  .typing-line {
    font-family: 'Anton', 'Arial Black', 'Inter', -apple-system, sans-serif;
    font-size: clamp(2.75rem, 13vw, 7.5rem);
    font-weight: 900;
    color: var(--ink);
    line-height: 0.95;
    overflow: hidden;
    white-space: nowrap;
    margin: 0;
    max-width: 100%;
    border-right: 0.1em solid var(--ink);
  }

  .typing-line-1 {
    width: 0;
    animation: type1 0.8s steps(6, end) forwards, blink-caret 0.7s step-end infinite;
    animation-delay: 1.4s, 1.4s;
  }

  .typing-line-2 {
    width: 0;
    border-right-color: transparent;
    animation: type2 0.9s steps(7, end) forwards, blink-caret 0.7s step-end infinite;
    animation-delay: 2.3s, 2.3s;
  }

  @keyframes type1 { to { width: 6.5ch; } }
  @keyframes type2 { to { width: 7.5ch; border-right-color: var(--ink); } }

  @keyframes blink-caret {
    from, to { border-right-color: transparent; }
    50% { border-right-color: var(--ink); }
  }

  .splash-tagline {
    margin-top: 20px;
    font-family: 'Inter', -apple-system, sans-serif;
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--forest);
    opacity: 0;
    transform: translateY(8px);
    animation: fade-in-up 0.7s ease forwards;
    animation-delay: 3.1s;
  }

  @keyframes fade-in-up {
    to { opacity: 1; transform: translateY(0); }
  }

  /* --- Pulsante Salta --- */
  .splash-skip {
    position: absolute;
    bottom: calc(20px + env(safe-area-inset-bottom));
    right: calc(20px + env(safe-area-inset-right));
    z-index: 10;
    background: transparent;
    border: 1px solid rgba(1, 71, 46, 0.35);
    color: var(--ink);
    font-family: 'Inter', -apple-system, sans-serif;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: lowercase;
    min-height: 44px;
    min-width: 44px;
    padding: 8px 18px;
    border-radius: 999px;
    cursor: pointer;
    opacity: 0;
    animation: fade-in 0.5s ease forwards;
    animation-delay: 0.5s;
    transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease;
    -webkit-tap-highlight-color: transparent;
  }

  .splash-skip:hover,
  .splash-skip:active {
    background: var(--ink);
    color: var(--cream);
    border-color: var(--ink);
  }

  @keyframes fade-in { to { opacity: 1; } }

  @keyframes splash-fadeout {
    0% { opacity: 1; }
    100% { opacity: 0; visibility: hidden; pointer-events: none; }
  }

  /* --- Adattamenti Smartphone --- */
  @media (max-width: 480px) {
    .typing-line { font-size: clamp(2.3rem, 15vw, 3.6rem); border-right-width: 0.08em; }
    .splash-tagline { font-size: 0.72rem; margin-top: 14px; padding: 0 12px; }
    .splash-skip { bottom: calc(14px + env(safe-area-inset-bottom)); right: calc(14px + env(safe-area-inset-right)); font-size: 0.68rem; padding: 8px 14px; }
    .leaf-1, .leaf-3, .leaf-5, .leaf-7 { width: 32px; }
    .leaf-2, .leaf-4, .leaf-6, .leaf-8 { width: 20px; }
  }

  @media (max-height: 480px) {
    .typing-line { font-size: clamp(1.9rem, 9vh, 3rem); }
    .splash-tagline { margin-top: 8px; }
    .leaves { display: none; }
  }

  /* --- Accessibilità --- */
  @media (prefers-reduced-motion: reduce) {
    .leaf, .typing-line, .splash-tagline, .splash-skip {
      animation: none !important;
      opacity: 1 !important;
      transform: none !important;
      width: auto !important;
      border-right-color: transparent !important;
    }
  }
</style>

<script>
  (function () {
    var splash = document.getElementById('splash-screen');
    var skipBtn = document.getElementById('splash-skip');
    if (!splash) return;

    var splashStorageKey = 'ciullo-tracker-splash-shown-at';
    var splashInterval = 3 * 60 * 60 * 1000;
    var lastShown = 0;

    try {
      lastShown = Number(localStorage.getItem(splashStorageKey));
    } catch (e) {
      lastShown = 0;
    }

    if (lastShown && Date.now() - lastShown < splashInterval) {
      splash.remove();
      return;
    }

    try {
      localStorage.setItem(splashStorageKey, String(Date.now()));
    } catch (e) {
      /* ignorato */
    }

    function hideSplash() {
      splash.style.animation = 'splash-fadeout 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards';
    }

    if (skipBtn) {
      skipBtn.addEventListener('click', hideSplash);
    }

    setTimeout(hideSplash, 5000);
  })();
</script>