<div id="splash-screen" class="splash-screen" style="display:none;">
  <svg viewBox="0 0 300 220" width="220" height="160" xmlns="http://www.w3.org/2000/svg">
    <!-- terreno -->
    <rect x="0" y="190" width="300" height="30" fill="#888" />

    <!-- lampione -->
    <rect x="205" y="40" width="8" height="150" rx="3" fill="#333" />
    <circle cx="209" cy="35" r="18" fill="#ddd" />
    <circle cx="209" cy="35" r="18" fill="none" stroke="#333" stroke-width="3" />
    <rect x="196" y="18" width="26" height="6" rx="2" fill="#333" />

    <!-- pozzetto pipì (appare gradualmente) -->
    <ellipse id="splash-puddle" cx="196" cy="197" rx="0" ry="0" fill="#aaa" opacity="0.85" />

    <!-- getto pipì -->
    <path id="splash-stream" d="M 187 150 Q 178 165 190 195" fill="none" stroke="#999" stroke-width="4" stroke-linecap="round" opacity="0" />

    <!-- cane -->
    <g id="splash-dog" transform="translate(60,150)">
      <!-- corpo -->
      <ellipse cx="60" cy="20" rx="38" ry="16" fill="#555" />
      <!-- testa -->
      <circle cx="105" cy="10" r="16" fill="#555" />
      <!-- orecchio -->
      <path d="M 108 -2 Q 118 -14 116 2 Z" fill="#222" />
      <!-- occhio -->
      <circle cx="112" cy="8" r="2" fill="#fff" />
      <circle cx="111" cy="8" r="1" fill="#000" />
      <!-- naso -->
      <circle cx="120" cy="12" r="2.5" fill="#222" />
      <!-- coda -->
      <path id="splash-tail" d="M 25 12 Q 8 4 14 -8" fill="none" stroke="#555" stroke-width="7" stroke-linecap="round" />
      <!-- zampe anteriori -->
      <rect x="80" y="30" width="7" height="18" rx="3" fill="#333" />
      <rect x="93" y="30" width="7" height="18" rx="3" fill="#333" />
      <!-- zampa posteriore a terra -->
      <rect x="35" y="30" width="8" height="18" rx="3" fill="#333" />
      <!-- zampa posteriore alzata -->
      <g id="splash-leg" style="transform-origin: 55px 24px;">
        <rect x="50" y="20" width="8" height="16" rx="3" fill="#333" />
      </g>
    </g>
  </svg>
  <div class="splash-text">CiulloTracker</div>
</div>

<style>
  .splash-screen {
    position: fixed;
    inset: 0;
    z-index: 9999;
    background: linear-gradient(180deg, #f5f5f5 0%, #e0e0e0 100%);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    animation: splash-fadeout 0.8s ease forwards;
    animation-delay: 4.2s;
  }
  .splash-text {
    margin-top: 12px;
    font-weight: 700;
    font-size: 1.1rem;
    color: #222;
    opacity: 0;
    animation: splash-text-in 0.6s ease forwards;
    animation-delay: 0.5s;
  }
  #splash-leg {
    animation: splash-leg-lift 3.6s ease-in-out;
  }
  #splash-tail {
    animation: splash-tail-wag 0.6s ease-in-out infinite;
  }
  #splash-stream {
    animation: splash-stream-flow 3.6s ease-in-out;
  }
  #splash-puddle {
    animation: splash-puddle-grow 3.6s ease-in-out forwards;
  }

  /* TIMING PRECISO - 5 secondi totali:
     0.0s - 0.5s: testo in fade-in
     0.0s - 3.6s: animazioni principali (gamba, getto, pozzetto)
     3.6s - 4.2s: pausa di visualizzazione (0.6s)
     4.2s - 5.0s: fadeout finale (0.8s)
  */

  @keyframes splash-text-in {
    0% { opacity: 0; }
    100% { opacity: 1; }
  }

  @keyframes splash-leg-lift {
    0% { transform: rotate(0deg); }
    5% { transform: rotate(0deg); }        /* 0.0s - 0.18s: pausa */
    30% { transform: rotate(-55deg); }     /* 0.18s - 1.08s: solleva */
    85% { transform: rotate(-55deg); }     /* 1.08s - 3.06s: mantiene */
    100% { transform: rotate(0deg); }      /* 3.06s - 3.6s: abbassa */
  }

  @keyframes splash-tail-wag {
    0% { transform: rotate(0deg); }
    25% { transform: rotate(15deg); }
    50% { transform: rotate(0deg); }
    75% { transform: rotate(15deg); }
    100% { transform: rotate(0deg); }
  }

  @keyframes splash-stream-flow {
    0% { opacity: 0; }
    10% { opacity: 0; }                    /* 0.0s - 0.36s: nessun getto */
    30% { opacity: 1; }                    /* 0.36s - 1.08s: inizia getto */
    85% { opacity: 1; }                    /* 1.08s - 3.06s: getto attivo */
    95% { opacity: 0; }                    /* 3.06s - 3.42s: getto termina */
    100% { opacity: 0; }                   /* 3.42s - 3.6s: nessun getto */
  }

  @keyframes splash-puddle-grow {
    0% { rx: 0; ry: 0; }
    15% { rx: 0; ry: 0; }                  /* 0.0s - 0.54s: nessuna pozzetta */
    35% { rx: 8; ry: 3; }                  /* 0.54s - 1.26s: inizia a formarsi */
    85% { rx: 18; ry: 7; }                 /* 1.26s - 3.06s: cresce gradualmente */
    100% { rx: 20; ry: 8; }                /* 3.06s - 3.6s: dimensione finale */
  }

  @keyframes splash-fadeout {
    0% { opacity: 1; }
    100% { opacity: 0; visibility: hidden; pointer-events: none; }
  }
</style>

<script>
  (function () {
    try {
      if (!localStorage.getItem('hbt-splash-seen')) {
        document.getElementById('splash-screen').style.display = 'flex';
        localStorage.setItem('hbt-splash-seen', '1');
      }
    } catch (e) {
      // localStorage non disponibile: nessuna splash, nessun errore bloccante
    }
  })();
</script>