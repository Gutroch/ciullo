  </svg>

  <!-- Foglie giungla: Bordo Destro -->
  <svg class="jungle-layer jungle-right" viewBox="0 0 250 800" preserveAspectRatio="xMaxYMid slice" aria-hidden="true">
    <path d="M250,0 L250,800 L150,800 Q100,700 160,650 Q70,600 120,500 Q50,450 100,350 Q30,300 90,200 Q20,150 80,50 Q40,20 90,0 Z" fill="#588157" opacity="0.5"/>
    <path d="M250,0 L250,800 L170,800 Q120,720 180,660 Q90,610 140,510 Q70,460 120,360 Q50,310 110,210 Q40,160 100,60 Q60,30 110,0 Z" fill="#344e41"/>
