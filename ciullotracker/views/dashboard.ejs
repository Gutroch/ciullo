<!DOCTYPE html>
<html lang="it">
<head>
  <%- include('partials/head', { title: 'Dashboard · CiulloTracker' }) %>
  <style>
    /* Stili specifici per la dashboard */
    .grid-4 {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 16px;
      margin-bottom: 24px;
    }

    .grid-2 {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 20px;
      margin-bottom: 24px;
    }

    .kpi-card {
      padding: 20px;
      text-align: center;
      transition: all 0.3s ease;
    }

    .kpi-card:hover {
      transform: translateY(-2px);
      box-shadow: 6px 6px 0px var(--ink);
    }

    .kpi-label {
      font-size: 0.8rem;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      color: var(--text-secondary);
      margin-bottom: 8px;
    }

    .kpi-value {
      font-size: 1.8rem;
      font-weight: 700;
      color: var(--text-primary);
    }

    .kpi-value.positive { color: var(--positive); }
    .kpi-value.negative { color: var(--negative); }
    .kpi-value.neutral { color: var(--text-primary); }

    .chart-card {
      padding: 20px;
      position: relative;
      transition: all 0.3s ease;
    }

    .chart-card:hover {
      transform: translateY(-2px);
      box-shadow: 6px 6px 0px var(--ink);
    }

    .chart-title {
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 1rem;
      font-weight: 600;
      color: var(--text-secondary);
      margin-bottom: 16px;
    }

    .chart-card canvas {
      max-height: 280px;
      max-width: 100%;
    }

    .chart-controls {
      display: flex;
      gap: 12px;
      margin-bottom: 12px;
      align-items: center;
      flex-wrap: wrap;
    }

    .chart-controls label {
      font-weight: 500;
      color: var(--text-secondary);
      font-size: 0.9rem;
    }

    .chart-controls .input {
      width: auto;
      flex: 0;
      padding: 6px 12px;
    }

    .expense-item {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 12px 16px;
      border-bottom: 1px solid var(--border-color);
      transition: background 0.2s;
    }

    .expense-item:last-child {
      border-bottom: none;
    }

    .expense-item:hover {
      background: var(--bg-hover);
    }

    .expense-meta {
      flex: 1;
    }

    .expense-cat {
      font-size: 0.75rem;
      color: var(--text-secondary);
      text-transform: uppercase;
      letter-spacing: 0.3px;
    }

    .expense-name {
      font-weight: 500;
      display: block;
      margin: 2px 0;
    }

    .expense-sub {
      font-size: 0.8rem;
      color: var(--text-secondary);
    }

    .expense-amount {
      font-weight: 600;
      font-size: 1.1rem;
      margin-left: 16px;
      white-space: nowrap;
    }

    .empty-state {
      padding: 40px 20px;
      text-align: center;
      color: var(--text-secondary);
    }

    .empty-state a {
      color: var(--accent);
      text-decoration: underline;
    }

    .qty-btn-group {
      display: flex;
      gap: 4px;
      align-items: center;
    }

    .qty-btn {
      width: 28px;
      height: 28px;
      border-radius: 50%;
      border: var(--border-w) solid var(--border);
      background: var(--bg-secondary);
      color: var(--text-primary);
      cursor: pointer;
      font-size: 1rem;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: all 0.2s;
    }

    .qty-btn:hover {
      background: var(--bg-hover);
      transform: scale(1.1);
    }

    .qty-btn:active {
      transform: scale(0.9);
    }

    .qty-btn.inc { color: var(--positive); }
    .qty-btn.dec { color: var(--negative); }

    .dashboard-qty-btn {
      display: flex;
      gap: 8px;
      margin-top: 8px;
    }

    .dashboard-qty-btn .qty-btn {
      width: 28px;
      height: 28px;
      border-radius: 50%;
      border: var(--border-w) solid var(--border);
      background: var(--bg-secondary);
      color: var(--text-primary);
      cursor: pointer;
      font-size: 1rem;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: all 0.2s;
    }

    .dashboard-qty-btn .qty-btn:hover {
      background: var(--bg-hover);
      transform: scale(1.1);
    }

    .dashboard-qty-btn .qty-btn:active {
      transform: scale(0.9);
    }

    .dashboard-qty-btn .qty-btn.inc { color: var(--positive); }
    .dashboard-qty-btn .qty-btn.dec { color: var(--negative); }

    .toast-notification {
      position: fixed;
      bottom: 30px;
      right: 30px;
      padding: 12px 24px;
      border-radius: 12px;
      background: var(--bg-secondary);
      border: var(--border-w) solid var(--border);
      box-shadow: 8px 8px 0px var(--ink);
      font-weight: 500;
      z-index: 9999;
      animation: slideIn 0.3s ease;
      max-width: 90%;
    }

    .toast-notification.success {
      border-left: 4px solid var(--positive);
      color: var(--positive);
    }

    .toast-notification.error {
      border-left: 4px solid var(--negative);
      color: var(--negative);
    }

    .toast-notification.fade-out {
      animation: slideOut 0.3s ease forwards;
    }

    @keyframes slideIn {
      from { transform: translateX(100%); opacity: 0; }
      to { transform: translateX(0); opacity: 1; }
    }

    @keyframes slideOut {
      from { transform: translateX(0); opacity: 1; }
      to { transform: translateX(100%); opacity: 0; }
    }

    .increment-popup-overlay {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background: rgba(0,0,0,0.6);
      backdrop-filter: blur(8px);
      display: flex;
      justify-content: center;
      align-items: center;
      z-index: 10000;
      animation: fadeIn 0.3s ease;
    }

    .increment-popup {
      background: var(--surface);
      border-radius: 20px;
      padding: 32px;
      max-width: 420px;
      width: 90%;
      box-shadow: 10px 10px 0px var(--ink);
      animation: modalIn 0.3s ease;
      border: var(--border-w) solid var(--border);
      color: var(--text);
    }

    .increment-popup h3 {
      margin: 0 0 20px 0;
      color: var(--text);
      font-size: 1.3rem;
      text-align: center;
    }

    .increment-popup .popup-body {
      margin-bottom: 24px;
    }

    .increment-popup .popup-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 12px 0;
      border-bottom: 1px solid var(--border);
    }

    .increment-popup .popup-row:last-child {
      border-bottom: none;
    }

    .increment-popup .popup-label {
      color: var(--text-muted);
      font-size: 0.9rem;
    }

    .increment-popup .popup-value {
      font-weight: 600;
      font-size: 1.1rem;
      color: var(--text);
    }

    .increment-popup .popup-value.old {
      color: var(--text-muted);
    }

    .increment-popup .popup-value.new {
      font-size: 1.8rem;
      font-weight: 700;
    }

    .increment-popup .popup-value.new.positive {
      color: var(--positive);
    }

    .increment-popup .popup-value.new.negative {
      color: var(--negative);
    }

    .increment-popup .popup-actions {
      display: flex;
      gap: 12px;
      justify-content: flex-end;
      margin-top: 8px;
    }

    .increment-popup .popup-cancel {
      padding: 10px 24px;
      border-radius: 10px;
      border: var(--border-w) solid var(--border);
      background: transparent;
      color: var(--text-muted);
      cursor: pointer;
      transition: all 0.2s;
      font-weight: 500;
      font-size: 0.95rem;
    }

    .increment-popup .popup-cancel:hover {
      background: var(--surface-alt);
    }

    .increment-popup .popup-confirm {
      padding: 10px 24px;
      border-radius: 10px;
      border: none;
      color: white;
      cursor: pointer;
      transition: all 0.2s;
      font-weight: 600;
      font-size: 0.95rem;
    }

    .increment-popup .popup-confirm.positive {
      background: var(--positive);
    }

    .increment-popup .popup-confirm.positive:hover {
      background: #4A6B42;
      transform: scale(1.02);
    }

    .increment-popup .popup-confirm.negative {
      background: var(--negative);
    }

    .increment-popup .popup-confirm.negative:hover {
      background: #8F3A2C;
      transform: scale(1.02);
    }

    .increment-popup .popup-confirm:active {
      transform: scale(0.98);
    }

    .quick-amount-btn {
      padding: 4px 12px;
      border-radius: 6px;
      border: var(--border-w) solid var(--border);
      background: var(--surface-alt);
      color: var(--text-muted);
      cursor: pointer;
      font-size: 0.8rem;
      transition: all 0.2s;
    }

    .quick-amount-btn:hover {
      background: var(--surface-alt);
      border-color: var(--positive);
    }

    .popup-input {
      width: 100%;
      padding: 10px 14px;
      border: var(--border-w) solid var(--border);
      border-radius: 8px;
      background: var(--surface-alt);
      color: var(--text);
      font-size: 1.1rem;
      box-sizing: border-box;
      transition: border-color 0.2s;
    }

    .popup-input:focus {
      outline: none;
      border-color: var(--positive);
      box-shadow: 4px 4px 0px var(--ink);
    }

    @keyframes fadeIn {
      from { opacity: 0; }
      to { opacity: 1; }
    }

    @keyframes modalIn {
      from { transform: scale(0.9) translateY(20px); opacity: 0; }
      to { transform: scale(1) translateY(0); opacity: 1; }
    }

    .chart-modal-overlay {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background: rgba(0,0,0,0.7);
      backdrop-filter: blur(4px);
      display: none;
      justify-content: center;
      align-items: center;
      z-index: 9998;
      padding: 20px;
    }

    .chart-modal-content {
      background: var(--bg-primary, var(--surface));
      border-radius: 16px;
      max-width: 90vw;
      max-height: 90vh;
      width: 800px;
      padding: 30px;
      box-shadow: 10px 10px 0px var(--ink);
      position: relative;
      animation: modalIn 0.3s ease;
    }

    .chart-modal-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 20px;
      padding-bottom: 12px;
      border-bottom: 1px solid var(--border-color, var(--border));
    }

    .chart-modal-header h3 {
      margin: 0;
      font-size: 1.2rem;
      color: var(--text-primary, var(--text));
    }

    .chart-modal-close-btn {
      background: none;
      border: none;
      font-size: 2rem;
      cursor: pointer;
      color: var(--text-secondary, var(--text-muted));
      padding: 0 8px;
      transition: color 0.2s;
    }

    .chart-modal-close-btn:hover {
      color: var(--text-primary, var(--text));
    }

    .chart-modal-body {
            position: relative;
            display: flex;
            align-items: center;
            justify-content: center;
            width: 100%;
            height: min(60vh, 620px);
            min-height: 280px;
            margin-bottom: 20px;
            overflow: hidden;
    }

    .chart-modal-body canvas {
            display: block;
            position: relative;
            flex: 0 1 auto;
            width: 100% !important;
            max-width: 100%;
            margin: 0 auto;
      width: 100% !important;
      height: auto !important;
            max-height: 100%;
    }

    .chart-modal-footer {
      padding-top: 12px;
      border-top: 1px solid var(--border-color, var(--border));
      color: var(--text-secondary, var(--text-muted));
      font-size: 0.9rem;
      text-align: center;
    }

    .chart-fullscreen {
      background: none !important;
      border: none !important;
      padding: 4px 8px;
      font-size: 1.2rem;
      cursor: pointer;
      color: var(--text-secondary, var(--text-muted));
      transition: color 0.2s;
    }

        .chart-actions {
            display: inline-flex;
            align-items: center;
            gap: 4px;
        }

        .chart-download {
            background: none;
            border: none;
            padding: 4px 8px;
            font-size: 0.95rem;
            cursor: pointer;
            color: var(--text-secondary, var(--text-muted));
        }

        .chart-download:hover { color: var(--text-primary, var(--text)); }

        .chart-period-hint {
            margin: -8px 0 18px;
            color: var(--text-muted);
            font-size: 0.75rem;
        }

        .chart-period-form {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            color: var(--text-muted);
            font-size: 0.75rem;
        }

        .chart-period-form .input {
            width: auto;
            min-width: 120px;
            padding: 7px 10px;
            font-size: 0.82rem;
        }

        .chart-period-form .input:last-child { min-width: 88px; }

    .chart-fullscreen:hover {
      color: var(--text-primary, var(--text));
    }

    .btn-sm {
      padding: 4px 12px;
      font-size: 0.8rem;
    }

    @media (max-width: 768px) {
      .grid-2 {
        grid-template-columns: 1fr;
      }
      
      .grid-4 {
        grid-template-columns: repeat(2, 1fr);
      }
      
      .kpi-value {
        font-size: 1.4rem;
      }
      
      .chart-modal-content {
        padding: 16px;
        width: 95vw;
      }

            .chart-modal-body {
                height: 52vh;
                min-height: 240px;
            }
      
      .expense-item {
        flex-direction: column;
        align-items: flex-start;
        gap: 8px;
      }
      
      .expense-amount {
        margin-left: 0;
        align-self: flex-end;
      }

      .chart-controls {
        flex-direction: column;
        align-items: stretch;
      }

    .chart-actions { gap: 0; }
    .chart-modal-header { align-items: flex-start; gap: 8px; }
    .chart-period-form { flex-wrap: wrap; }

      .chart-controls .input {
        width: 100%;
      }
    }

    :root {
      --bg-primary: var(--surface);
      --bg-secondary: var(--surface-alt);
      --bg-hover: var(--surface-alt);
      --text-primary: var(--text);
      --text-secondary: var(--text-muted);
      --border-color: var(--border);
      --accent: var(--text);
      --danger: var(--negative);
    }

    [data-theme="dark"] {
      --bg-primary: #1e1e1e;
      --bg-secondary: #2d2d2d;
      --bg-hover: #3a3a3a;
      --text-primary: #f5f5f5;
      --text-secondary: #b0b0b0;
      --border-color: #444444;
    }
    .chart-breadcrumb {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-left: auto;
    font-size: 0.9rem;
}
.breadcrumb-btn {
    background: var(--bg-secondary);
    border: var(--border-w) solid var(--border);
    color: var(--text-primary);
    padding: 4px 12px;
    border-radius: 8px;
    cursor: pointer;
    font-size: 0.85rem;
    transition: all 0.2s;
}
.breadcrumb-btn:hover {
    background: var(--bg-hover);
    border-color: var(--positive);
    color: var(--positive);
}
.breadcrumb-sep {
    color: var(--text-secondary);
}
.breadcrumb-current {
    font-weight: 600;
    color: var(--text-primary);
    max-width: 200px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}
#chartCategorie {
    cursor: pointer;
    transition: opacity 0.2s;
}

.chart-modal-body {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 20px;
}

/* se usi width:100%, il canvas occuperà tutto lo spazio del flex container, 
   quindi sarà già centrato perché il container lo è */
.chart-modal-body canvas {
  width: 100% !important;
  max-height: 60vh;
  height: auto !important;
}

#chart-modal-canvas {
    display: none !important;
}
  </style>
</head>
<body>
<div class="blob-field" aria-hidden="true"><div class="blob blob-1"></div><div class="blob blob-2"></div><div class="blob blob-3"></div></div>
  <%- include('partials/splash') %>
  <div class="app-shell">
    <%- include('partials/nav', { user: user, active: 'dashboard' }) %>

    <main class="main-content">
      <div class="page-title">Dashboard</div>
    <div class="page-subtitle" style="text-transform:capitalize;"><%= meseLabel %></div>
    <div class="chart-period-hint">Per cambiare periodo, allarga un grafico e scegli mese e anno.</div>

      <!-- KPI Cards -->
      <div class="grid-4">
        <div class="card squircle kpi-card">
          <div class="kpi-label">Totale Uscite</div>
          <div class="kpi-value negative">€ <%= totale %></div>
        </div>
        <div class="card squircle kpi-card">
          <div class="kpi-label">Totale Entrate</div>
          <div class="kpi-value positive">€ <%= totaleIngressi %></div>
        </div>
        <div class="card squircle kpi-card">
          <div class="kpi-label">Saldo</div>
          <div class="kpi-value <%= parseFloat(saldo) < 0 ? 'negative' : 'positive' %>">€ <%= saldo %></div>
        </div>
        <div class="card squircle kpi-card">
          <div class="kpi-label">Categoria Top</div>
          <div class="kpi-value neutral"><%= topCategoria %></div>
        </div>
        <div class="card squircle kpi-card">
          <div class="kpi-label">Totale Movimenti</div>
          <div class="kpi-value neutral"><%= typeof numeroMovimenti !== 'undefined' ? numeroMovimenti : 0 %></div>
        </div>
      </div>

      <!-- Grafici -->
      <div class="grid-2">
        <!-- Grafico Categorie con drill-down -->
<div class="card squircle chart-card" data-chart="categorie">
    <div class="chart-title">
        <span>Spese per Categoria</span>
        <span class="chart-actions">
            <button class="chart-download" data-chart="categorie" title="Scarica grafico" aria-label="Scarica grafico">↓</button>
            <button class="chart-fullscreen" data-chart="categorie" title="Apri a tutto schermo" aria-label="Apri a tutto schermo">⤢</button>
        </span>
    </div>
    <div class="chart-controls">
        <label for="chartTipoSelect">Tipo:</label>
        <select id="chartTipoSelect" class="input">
            <option value="uscite">Uscite</option>
            <option value="ingressi">Entrate</option>
        </select>
        <div id="chartBreadcrumb" class="chart-breadcrumb" style="display:none;">
            <button id="breadcrumbBack" class="breadcrumb-btn" title="Torna alle macrocategorie">
                ← Macro
            </button>
            <span class="breadcrumb-sep">/</span>
            <span id="breadcrumbCategory" class="breadcrumb-current"></span>
        </div>
    </div>
    <canvas id="chartCategorie"></canvas>
    <div id="chartNoData" class="empty-state" style="display:none; padding: 20px;">
        Nessun dato disponibile per questa selezione.
    </div>
</div>
        <div class="card squircle chart-card" data-chart="giornaliero">
          <div class="chart-title">
            <span>Andamento Giornaliero</span>
                        <span class="chart-actions">
                            <button class="chart-download" data-chart="giornaliero" title="Scarica grafico" aria-label="Scarica grafico">↓</button>
                            <button class="chart-fullscreen" data-chart="giornaliero" title="Apri a tutto schermo" aria-label="Apri a tutto schermo">⤢</button>
                        </span>
          </div>
          <canvas id="chartGiornaliero"></canvas>
        </div>
      </div>

      <!-- Trend mensile -->
      <div class="card squircle chart-card" data-chart="trend" style="margin-bottom: 24px;">
        <div class="chart-title">
          <span>Trend Mensile (Ultimi 6 mesi)</span>
                    <span class="chart-actions">
                        <button class="chart-download" data-chart="trend" title="Scarica grafico" aria-label="Scarica grafico">↓</button>
                        <button class="chart-fullscreen" data-chart="trend" title="Apri a tutto schermo" aria-label="Apri a tutto schermo">⤢</button>
                    </span>
        </div>
        <canvas id="chartTrend"></canvas>
      </div>

      <!-- Prossime scadenze -->
      <% if (prossimeScadenze && prossimeScadenze.length > 0) { %>
        <div class="card squircle" style="margin-bottom: 24px;">
          <div class="chart-title">
            <span>Prossime Scadenze Ricorrenti</span>
            <a href="/recurring" style="font-weight:400; font-size:0.85rem; text-decoration:underline; color: var(--accent);">Gestisci</a>
          </div>
          <% prossimeScadenze.forEach(function(r) { %>
            <div class="expense-item">
              <div class="expense-meta">
                <span class="expense-cat"><%= r.categoria %><%= r.sottocategoria ? ' → ' + r.sottocategoria : '' %></span>
                <span class="expense-name"><%= r.descrizione %></span>
                <span class="expense-sub">Scade il <%= new Date(r.prossimaData).toLocaleDateString('it-IT') %></span>
              </div>
              <div class="expense-amount" style="color: <%= r.tipo === 'ingresso' ? 'var(--positive)' : 'var(--negative)' %>;">
                <%= r.tipo === 'ingresso' ? '+' : '−' %> € <%= r.importo.toFixed(2) %>
              </div>
            </div>
          <% }); %>
        </div>
      <% } %>

      <!-- Ultimi movimenti -->
      <div class="card squircle">
        <div class="chart-title">
          <span>Ultimi Movimenti del Mese</span>
          <a href="/history" style="font-weight:400; font-size:0.85rem; text-decoration:underline; color: var(--accent);">Vedi tutti</a>
        </div>
        <% if (ultimeSpese.length === 0) { %>
          <div class="empty-state">
            Nessun movimento registrato questo mese. 
            <a href="/expenses/new">Aggiungine uno</a>.
          </div>
        <% } else { %>
          <% ultimeSpese.forEach(function(e) { %>
            <div class="expense-item" data-id="<%= e.id %>">
              <div class="expense-meta">
                <span class="expense-cat"><%= e.categoria %><%= e.sottocategoria ? ' → ' + e.sottocategoria : '' %></span>
                <span class="expense-name"><%= e.note && e.note.length ? e.note : e.categoria %></span>
                <span class="expense-sub">
                  <%= new Date(e.data_spesa).toLocaleDateString('it-IT') %> · 
                  <%= e.inserito_da %> → <%= e.per_conto_di %>
                </span>
              </div>
              <div class="expense-amount" style="color: <%= e.tipo === 'ingresso' ? 'var(--positive)' : 'var(--negative)' %>;">
                <%= e.tipo === 'ingresso' ? '+' : '−' %> € <%= e.importo.toFixed(2) %>
              </div>
            </div>
          <% }); %>
        <% } %>
      </div>
    </main>
  </div>

    <%- include('partials/footer', { user: user }) %>

  <!-- MODAL PER GRAFICI FULLSCREEN -->
  <div id="chart-modal" class="chart-modal-overlay" style="display: none;">
    <div class="chart-modal-content">
      <div class="chart-modal-header">
        <h3 id="chart-modal-title">Dettagli Grafico</h3>
                <form class="chart-period-form" method="GET" action="/">
                    <label for="chartModalMonth">Periodo</label>
                    <select id="chartModalMonth" name="mese" class="input" aria-label="Mese">
                        <% ['Gennaio', 'Febbraio', 'Marzo', 'Aprile', 'Maggio', 'Giugno', 'Luglio', 'Agosto', 'Settembre', 'Ottobre', 'Novembre', 'Dicembre'].forEach(function(nome, indice) { %>
                            <option value="<%= indice + 1 %>" <%= selectedMonth === indice + 1 ? 'selected' : '' %>><%= nome %></option>
                        <% }); %>
                    </select>
                    <select id="chartModalYear" name="anno" class="input" aria-label="Anno">
                        <% years.forEach(function(availableYear) { %>
                            <option value="<%= availableYear %>" <%= selectedYear === availableYear ? 'selected' : '' %>><%= availableYear %></option>
                        <% }); %>
                    </select>
                    <button id="chart-modal-close" class="chart-modal-close-btn" type="button" aria-label="Chiudi">&times;</button>
                </form>
      </div>
      <div class="chart-modal-body">
        <canvas id="chart-modal-canvas"></canvas>
      </div>
      <div class="chart-modal-footer" id="chart-modal-details">
                <button id="chart-modal-download" class="btn btn-secondary btn-sm" type="button">↓ Scarica PNG</button>
                <span id="chart-modal-note">Scegli mese e anno qui sopra per aggiornare la dashboard.</span>
      </div>
    </div>
  </div>

  <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.4/chart.umd.min.js"
          onerror="var s=document.createElement('script');s.src='https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js';document.head.appendChild(s);">
  </script>

  <script>
var dashboardChartData = {
    categorie: <%- JSON.stringify(chartCategorie) %>,
    sottocategorie: <%- JSON.stringify(chartSottocategorie || {}) %>,
    giornaliero: <%- JSON.stringify(chartGiornaliero) %>,
    trend: <%- JSON.stringify(chartTrend) %>
};

(function initDashboard() {

    if (window.__ciulloDashboardChartsInitialized) {
        return;
    }

    if (typeof Chart === 'undefined') {
        setTimeout(initDashboard, 200);
        return;
    }

    window.__ciulloDashboardChartsInitialized = true;

        function getThemeColors() {
        var dark = document.documentElement.getAttribute('data-theme') === 'dark';
        return {
            // 1. COLORI ESPLICITI (Il Canvas NON legge le variabili CSS "var(--...)")
            text: dark ? '#F2EFE7' : '#1C1B18',          // Corrisponde a --text nel tuo style.css
            grid: dark ? 'rgba(242, 239, 231, 0.1)' : 'rgba(28, 27, 24, 0.1)',
            bgPrimary: dark ? '#201E19' : '#FAF9F5',     // Corrisponde a --surface nel tuo style.css
            positive: dark ? '#8FB782' : '#5B7F52',
            negative: dark ? '#D08573' : '#B34A3A',
            
            // 2. PALETTE DI COLORI DIVERSI E DISTINTI (HEX fissi, Chart.js li legge perfettamente)
            palette: [
                '#B5714B', '#7C9473', '#4C6B8A', '#9AB68C',
                '#C9A227', '#8A7B9E', '#C97B4A', '#6E88A6',
                '#45B7D1', '#96CEB4', '#FFEAA7', '#DDA0DD'
            ]
        };
    }

    var colors = getThemeColors();


    // ============================================================
    // NORMALIZZAZIONE DATI
    // ============================================================

    function normalizeCategorie(raw) {

        if (!raw) {
            return {
                uscite: {
                    labels: [],
                    data: []
                },

                ingressi: {
                    labels: [],
                    data: []
                }
            };
        }

        if (raw.uscite || raw.ingressi) {

            return {
                uscite:
                    raw.uscite || {
                        labels: [],
                        data: []
                    },

                ingressi:
                    raw.ingressi || {
                        labels: [],
                        data: []
                    }
            };
        }

        return {
            uscite: {
                labels: raw.labels || [],
                data: raw.data || []
            },

            ingressi: {
                labels: [],
                data: []
            }
        };
    }


    function normalizeSottocategorie(raw) {

        if (!raw) {
            return {
                uscite: {},
                ingressi: {}
            };
        }

        if (raw.uscite || raw.ingressi) {

            return {
                uscite: raw.uscite || {},
                ingressi: raw.ingressi || {}
            };
        }

        return {
            uscite: raw,
            ingressi: {}
        };
    }


    var catData =
        normalizeCategorie(dashboardChartData.categorie);

    var subData =
        normalizeSottocategorie(
            dashboardChartData.sottocategorie
        );

    var giornoData =
        dashboardChartData.giornaliero || {
            labels: [],
            dataIngressi: [],
            dataUscite: []
        };

    var trendData =
        dashboardChartData.trend || {
            labels: [],
            dataIngressi: [],
            dataUscite: []
        };


    // ============================================================
    // GRAFICO CATEGORIE
    // ============================================================

    var ctxCategorie =
        document.getElementById('chartCategorie');

    var chartInstance =
        null;

    var currentTipo =
        'uscite';

    var currentView =
        'macro';

    var currentCategory =
        '';


    var tipoSelect =
        document.getElementById(
            'chartTipoSelect'
        );

    var breadcrumb =
        document.getElementById(
            'chartBreadcrumb'
        );

    var breadcrumbBack =
        document.getElementById(
            'breadcrumbBack'
        );

    var breadcrumbCategory =
        document.getElementById(
            'breadcrumbCategory'
        );

    var noDataMsg =
        document.getElementById(
            'chartNoData'
        );


    function getPalette(n) {

        var out = [];

        for (var i = 0; i < n; i++) {

            out.push(
                colors.palette[
                    i % colors.palette.length
                ]
            );
        }

        return out;
    }


    function renderCategorieChart() {

        if (!ctxCategorie) {
            return;
        }


        var labels = [];
        var data = [];
        var title = '';


        // ========================================================
        // VISTA MACRO
        // ========================================================

        if (currentView === 'macro') {

            var src =
                catData[currentTipo] || {
                    labels: [],
                    data: []
                };

            labels =
                src.labels || [];

            data =
                src.data || [];

            title =
                (
                    currentTipo === 'uscite'
                        ? 'Uscite'
                        : 'Entrate'
                ) +
                ' per Categoria';

            breadcrumb.style.display =
                'none';

        }

        // ========================================================
        // VISTA SOTTOCATEGORIE
        // ========================================================

        else {

            var subs =
                (
                    subData[currentTipo] || {}
                )[currentCategory];


            if (
                subs &&
                subs.labels &&
                subs.labels.length > 0
            ) {

                labels =
                    subs.labels;

                data =
                    subs.data;

            } else {

                labels =
                    ['Nessuna sottocategoria'];

                data =
                    [0];
            }


            title =
                currentCategory;


            breadcrumb.style.display =
                'flex';

            breadcrumbCategory.textContent =
                currentCategory;
        }


        // ========================================================
        // NESSUN DATO
        // ========================================================

        if (
            labels.length === 0 ||
            (
                labels.length === 1 &&
                Number(data[0]) === 0
            )
        ) {

            if (chartInstance) {

                chartInstance.destroy();

                chartInstance =
                    null;
            }

            ctxCategorie.style.display =
                'none';

            noDataMsg.style.display =
                'block';

            return;
        }


        ctxCategorie.style.display =
            'block';

        noDataMsg.style.display =
            'none';


        if (chartInstance) {

            chartInstance.destroy();

            chartInstance =
                null;
        }


        var bgColors =
            getPalette(labels.length);


        // ========================================================
        // MACRO = DOUGHNUT
        // SOTTOCATEGORIE = BARRE ORIZZONTALI
        // ========================================================

        if (currentView === 'macro') {

            chartInstance =
                new Chart(ctxCategorie, {

                    type: 'doughnut',

                    data: {
                        labels: labels,

                        datasets: [{
                            data: data,

                            backgroundColor:
                                bgColors,

                            borderWidth: 2,

                            borderColor:
                                colors.bgPrimary,

                            hoverOffset: 8
                        }]
                    },

                    options: {

                        responsive: true,

                        maintainAspectRatio: true,

                        animation: {
                            duration: 500,
                            easing: 'easeOutQuart'
                        },

                        plugins: {

                            legend: {
                                position: 'bottom',

                                labels: {
                                    color:
                                        colors.text,

                                    boxWidth: 12,

                                    padding: 14,

                                    usePointStyle:
                                        true,

                                    pointStyle:
                                        'circle',

                                    font: {
                                        size: 12
                                    }
                                }
                            },

                            tooltip: {

                                backgroundColor:
                                    'rgba(0,0,0,0.85)',

                                titleColor:
                                    '#fff',

                                bodyColor:
                                    '#fff',

                                padding: 12,

                                cornerRadius: 8,

                                callbacks: {

                                    title:
                                        function(items) {

                                            return items[0]
                                                .label;
                                        },

                                    label:
                                        function(context) {

                                            var total =
                                                context
                                                    .dataset
                                                    .data
                                                    .reduce(
                                                        function(a, b) {
                                                            return a +
                                                                Number(b);
                                                        },
                                                        0
                                                    );

                                            var value =
                                                Number(
                                                    context.parsed
                                                ) || 0;

                                            var perc =
                                                total > 0
                                                    ? (
                                                        value /
                                                        total *
                                                        100
                                                    ).toFixed(1)
                                                    : '0.0';

                                            var prefix =
                                                currentTipo === 'uscite'
                                                    ? '−'
                                                    : '+';

                                            return (
                                                prefix +
                                                ' €' +
                                                value.toFixed(2) +
                                                ' (' +
                                                perc +
                                                '%)'
                                            );
                                        },

                                    afterLabel:
                                        function(context) {

                                            if (
                                                currentView ===
                                                'macro'
                                            ) {

                                                var subs =
                                                    (
                                                        subData[
                                                            currentTipo
                                                        ] || {}
                                                    )[context.label];

                                                if (
                                                    subs &&
                                                    subs.labels &&
                                                    subs.labels.length
                                                ) {
                                                    return '🔍 Click per vedere le sottocategorie';
                                                }
                                            }

                                            return '';
                                        }
                                }
                            }
                        },

                        cutout: '60%',

                        onClick:
                            handleChartClick
                    }
                });

        } else {

            chartInstance =
                new Chart(ctxCategorie, {

                    type: 'bar',

                    data: {

                        labels: labels,

                        datasets: [{
                            label:
                                currentCategory,

                            data: data,

                            backgroundColor:
                                bgColors,

                            borderColor:
                                bgColors,

                            borderWidth: 1,

                            borderRadius: 6,

                            barPercentage:
                                0.7
                        }]
                    },

                    options: {

                        responsive: true,

                        maintainAspectRatio:
                            true,

                        indexAxis: 'y',

                        animation: {
                            duration: 400
                        },

                        plugins: {

                            legend: {
                                display: false
                            },

                            tooltip: {

                                backgroundColor:
                                    'rgba(0,0,0,0.85)',

                                titleColor:
                                    '#fff',

                                bodyColor:
                                    '#fff',

                                padding: 12,

                                cornerRadius: 8,

                                callbacks: {

                                    label:
                                        function(context) {

                                            var value =
                                                Number(
                                                    context.parsed.x
                                                ) || 0;

                                            return (
                                                '€' +
                                                value.toFixed(2)
                                            );
                                        }
                                }
                            }
                        },

                        scales: {

                            x: {

                                beginAtZero: true,

                                grid: {
                                    color:
                                        colors.grid
                                },

                                ticks: {

                                    color:
                                        colors.text,

                                    callback:
                                        function(value) {

                                            return (
                                                '€' +
                                                Number(value)
                                                    .toFixed(0)
                                            );
                                        }
                                }
                            },

                            y: {

                                grid: {
                                    display: false
                                },

                                ticks: {
                                    color:
                                        colors.text
                                }
                            }
                        }
                    }
                });
        }
    }


    // ============================================================
    // CLICK SU MACRO CATEGORIA
    // ============================================================

    function handleChartClick(
        event,
        elements
    ) {

        if (
            currentView !== 'macro'
        ) {
            return;
        }

        if (
            !elements ||
            elements.length === 0
        ) {
            return;
        }


        var idx =
            elements[0].index;


        var clickedLabel =
            chartInstance
                .data
                .labels[idx];


        var subs =
            (
                subData[currentTipo] || {}
            )[clickedLabel];


        if (
            !subs ||
            !subs.labels ||
            subs.labels.length === 0
        ) {
            return;
        }


        currentCategory =
            clickedLabel;

        currentView =
            'sub';


        renderCategorieChart();
    }


    // ============================================================
    // SELECT ENTRATE / USCITE
    // ============================================================

    if (tipoSelect) {

        tipoSelect.addEventListener(
            'change',
            function() {

                currentTipo =
                    this.value;

                currentView =
                    'macro';

                currentCategory =
                    '';

                renderCategorieChart();
            }
        );
    }


    // ============================================================
    // TORNA ALLE MACRO
    // ============================================================

    if (breadcrumbBack) {

        breadcrumbBack.addEventListener(
            'click',
            function() {

                currentView =
                    'macro';

                currentCategory =
                    '';

                renderCategorieChart();
            }
        );
    }


    // ============================================================
    // KPI - CONTROLLO COERENZA
    // ============================================================

    var renderedKpi = {

        uscite:
            Number(
                <%- JSON.stringify(totale) %>
            ) || 0,

        entrate:
            Number(
                <%- JSON.stringify(totaleIngressi) %>
            ) || 0,

        saldo:
            Number(
                <%- JSON.stringify(saldo) %>
            ) || 0
    };


    function sumValues(values) {

        return (
            values || []
        ).reduce(
            function(sum, value) {

                var n =
                    Number(value);

                return sum +
                    (
                        Number.isFinite(n)
                            ? n
                            : 0
                    );
            },
            0
        );
    }


    var chartTotals = {

        uscite:
            sumValues(
                (catData.uscite || {})
                    .data
            ),

        entrate:
            sumValues(
                (catData.ingressi || {})
                    .data
            )
    };


    var epsilon =
        0.01;


    if (
        Math.abs(
            chartTotals.uscite -
            renderedKpi.uscite
        ) > epsilon ||

        Math.abs(
            chartTotals.entrate -
            renderedKpi.entrate
        ) > epsilon ||

        Math.abs(
            (
                renderedKpi.entrate -
                renderedKpi.uscite
            ) -
            renderedKpi.saldo
        ) > epsilon
    ) {

        console.warn(
            '[Dashboard] KPI non coerenti con i dati grafici',
            {
                kpi: renderedKpi,
                grafici: chartTotals
            }
        );
    }


    // ============================================================
    // AVVIO
    // ============================================================

    renderCategorieChart();


        // ============================================================
    // GRAFICO GIORNALIERO
    // ============================================================

    var ctxGiornaliero = document.getElementById('chartGiornaliero');

    if (ctxGiornaliero && giornoData.labels && giornoData.labels.length > 0) {
        new Chart(ctxGiornaliero, {
            type: 'bar',
            data: {
                labels: giornoData.labels,
                datasets: [
                    {
                        label: 'Entrate (€)',
                        data: giornoData.dataIngressi || [],
                        backgroundColor: 'rgba(124, 148, 115, 0.7)',
                        borderColor: colors.positive,
                        borderWidth: 2,
                        borderRadius: 6
                    },
                    {
                        label: 'Uscite (€)',
                        data: giornoData.dataUscite || [],
                        backgroundColor: 'rgba(255, 107, 107, 0.7)',
                        borderColor: colors.negative, 
                        borderWidth: 2,
                        borderRadius: 6
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: true,
                plugins: {
                    legend: {
                        display: true,
                        labels: {
                            color: colors.text, 
                            boxWidth: 16,
                            font: { size: 14 },
                            usePointStyle: true,
                            pointStyle: 'circle'
                        }
                    }
                },
                scales: {
                    x: {
                        ticks: { color: colors.text }, 
                        grid: { display: false }
                    },
                    y: {
                        ticks: {
                            color: colors.text, 
                            callback: function(v) {
                                return '€' + Number(v).toFixed(0);
                            }
                        },
                        grid: { color: colors.grid }, 
                        beginAtZero: true
                    }
                }
            }
        });
    }

      // ============================================================
    // TREND MENSILE
    // ============================================================

    var ctxTrend = document.getElementById('chartTrend');

    if (ctxTrend && trendData.labels && trendData.labels.length > 0) {
        new Chart(ctxTrend, {
            type: 'line',
            data: {
                labels: trendData.labels,
                datasets: [
                    {
                        label: 'Uscite mensili',
                        data: trendData.dataUscite || [],
                        borderColor: colors.negative, 
                        backgroundColor: 'rgba(255, 107, 107, 0.1)',
                        fill: true,
                        tension: 0.4,
                        pointBackgroundColor: colors.negative 
                    },
                    {
                        label: 'Entrate mensili',
                        data: trendData.dataIngressi || [],
                        borderColor: colors.positive, 
                        backgroundColor: 'rgba(124, 148, 115, 0.1)',
                        fill: true,
                        tension: 0.4,
                        pointBackgroundColor: colors.positive 
                    }
                ]
            },
            options: {
                responsive: true,
                plugins: {
                    legend: {
                        position: 'top',
                        labels: {
                            color: colors.text, 
                            usePointStyle: true
                        }
                    },
                    tooltip: {
                        callbacks: {
                            label: function(context) {
                                var value = Number(context.parsed.y) || 0;
                                return context.dataset.label + ': €' + value.toFixed(2);
                            }
                        }
                    }
                },
                scales: {
                    x: {
                        grid: { color: colors.grid }, 
                        ticks: { color: colors.text } 
                    },
                    y: {
                        grid: { color: colors.grid }, 
                        ticks: {
                            color: colors.text, 
                            callback: function(value) {
                                return '€' + Number(value).toFixed(0);
                            }
                        },
                        beginAtZero: true
                    }
                }
            }
        });
    }
    // ============================================================
    // POPUP, DOWNLOAD E PERIODO GRAFICI
    // ============================================================

    var chartModal = document.getElementById('chart-modal');
    var chartModalBody = chartModal && chartModal.querySelector('.chart-modal-body');
    var chartModalTitle = document.getElementById('chart-modal-title');
    var chartModalDownload = document.getElementById('chart-modal-download');
    var modalChart = null;
    var modalCanvas = null;
    var modalPlaceholder = null;

    function closeChartModal() {
        if (!chartModal || !modalCanvas || !modalPlaceholder) return;

        modalPlaceholder.parentNode.insertBefore(modalCanvas, modalPlaceholder);
        modalPlaceholder.remove();
        if (modalChart) modalChart.resize();
        modalCanvas = null;
        modalPlaceholder = null;
        modalChart = null;
        chartModal.style.display = 'none';
        document.body.style.overflow = '';
    }

    function openChartModal(button) {
        if (!chartModal || !chartModalBody) return;

        var sourceCanvas = document.getElementById('chart' + button.dataset.chart.charAt(0).toUpperCase() + button.dataset.chart.slice(1));
        var sourceChart = sourceCanvas && Chart.getChart(sourceCanvas);
        if (!sourceChart) return;

        modalChart = sourceChart;
        modalCanvas = sourceCanvas;
        modalPlaceholder = document.createElement('span');
        modalPlaceholder.setAttribute('aria-hidden', 'true');
        sourceCanvas.parentNode.insertBefore(modalPlaceholder, sourceCanvas);
        chartModalBody.appendChild(sourceCanvas);
        chartModalTitle.textContent = button.closest('.chart-card').querySelector('.chart-title > span').textContent;
        chartModal.style.display = 'flex';
        document.body.style.overflow = 'hidden';
        window.requestAnimationFrame(function() {
            window.requestAnimationFrame(function() {
                modalChart.resize();
            });
        });
    }

    document.querySelectorAll('.chart-fullscreen').forEach(function(button) {
        button.addEventListener('click', function() { openChartModal(button); });
    });

    document.querySelectorAll('.chart-download').forEach(function(button) {
        button.addEventListener('click', function() {
            var canvas = document.getElementById('chart' + button.dataset.chart.charAt(0).toUpperCase() + button.dataset.chart.slice(1));
            var chart = canvas && Chart.getChart(canvas);
            if (!chart) return;
            var link = document.createElement('a');
            link.download = 'ciullotracker-' + button.dataset.chart + '-<%= selectedYear %>-<%= selectedMonth %>.png';
            link.href = chart.toBase64Image('image/png', 1);
            link.click();
        });
    });

    if (document.getElementById('chart-modal-close')) {
        document.getElementById('chart-modal-close').addEventListener('click', closeChartModal);
    }
    if (chartModalDownload) {
        chartModalDownload.addEventListener('click', function() {
            if (!modalChart) return;
            var link = document.createElement('a');
            link.download = 'ciullotracker-grafico-<%= selectedYear %>-<%= selectedMonth %>.png';
            link.href = modalChart.toBase64Image('image/png', 1);
            link.click();
        });
    }
    if (chartModal) {
        chartModal.addEventListener('click', function(event) {
            if (event.target === chartModal) closeChartModal();
        });
    }
    document.addEventListener('keydown', function(event) {
        if (event.key === 'Escape') closeChartModal();
    });
    document.querySelector('.chart-period-form')?.addEventListener('change', function() {
        this.submit();
    });

    // 4. FORZA L'AGGIORNAMENTO DEI GRAFICI QUANDO CAMBI TEMA
    new MutationObserver(function() {
        location.reload(); // Ricarica la pagina per applicare i nuovi colori HEX a tutti i canvas
    }).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });

})();

</script>

</body>
</html>
