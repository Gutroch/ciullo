<!DOCTYPE html>
<html lang="it">
<head>
  <%- include('partials/head', { title: 'Dashboard · CiulloTracker' }) %>
</head>
<body>
  <%- include('partials/splash') %>
  <div class="app-shell">
    <%- include('partials/nav', { user: user, active: 'dashboard' }) %>

    <main class="main-content">
      <div class="page-title">Dashboard</div>
      <div class="page-subtitle" style="text-transform:capitalize;"><%= meseLabel %></div>

      <!-- KPI Cards -->
      <div class="grid grid-4" style="margin-bottom: 20px;">
        <div class="card squircle kpi-card">
          <div class="kpi-label">Totale speso nel mese</div>
          <div class="kpi-value">€ <%= totale %></div>
        </div>
        <div class="card squircle kpi-card">
          <div class="kpi-label">Totale entrate nel mese</div>
          <div class="kpi-value">€ <%= totaleIngressi %></div>
        </div>
        <div class="card squircle kpi-card">
          <div class="kpi-label">Saldo</div>
          <div class="kpi-value" style="color: <%= parseFloat(saldo) < 0 ? 'var(--danger)' : '#148c50' %>;">€ <%= saldo %></div>
        </div>
        <div class="card squircle kpi-card">
          <div class="kpi-label">Categoria principale</div>
          <div class="kpi-value"><%= topCategoria %></div>
        </div>
      </div>

      <!-- Grafici -->
      <div class="grid grid-2" style="margin-bottom: 20px;">
        <div class="card squircle chart-card" data-chart="categorie">
          <div class="chart-title">Spese per categoria <button class="btn btn-sm btn-secondary chart-fullscreen" title="Apri a tutto schermo">⤢</button></div>
          <canvas id="chartCategorie"></canvas>
        </div>
        <div class="card squircle chart-card" data-chart="giornaliero">
          <div class="chart-title">Andamento giornaliero <button class="btn btn-sm btn-secondary chart-fullscreen" title="Apri a tutto schermo">⤢</button></div>
          <canvas id="chartGiornaliero"></canvas>
        </div>
      </div>

      <!-- Promemoria spese ricorrenti in scadenza -->
      <% if (prossimeScadenze && prossimeScadenze.length > 0) { %>
        <div class="card squircle" style="margin-bottom: 20px;">
          <div class="chart-title">Prossime scadenze ricorrenti <a href="/recurring" style="font-weight:400; font-size:0.85rem; text-decoration:underline; float:right;">Gestisci</a></div>
          <% prossimeScadenze.forEach(function(r) { %>
            <div class="expense-item squircle-sm">
              <div class="expense-meta">
                <span class="expense-cat"><%= r.categoria %><%= r.sottocategoria ? ' → ' + r.sottocategoria : '' %></span>
                <span class="expense-name"><%= r.descrizione %></span>
                <span class="expense-sub">Scade il <%= r.prossimaData.toLocaleDateString('it-IT') %></span>
              </div>
              <div class="expense-amount"><%= r.tipo === 'ingresso' ? '+' : '−' %> € <%= r.importo.toFixed(2) %></div>
            </div>
          <% }); %>
        </div>
      <% } %>

      <!-- Feed ultimi movimenti -->
      <div class="card squircle">
        <div class="chart-title">Ultimi movimenti del mese</div>
        <% if (ultimeSpese.length === 0) { %>
          <div class="empty-state">Nessun movimento registrato questo mese. <a href="/expenses/new" style="text-decoration:underline;">Aggiungine uno</a>.</div>
        <% } else { %>
          <% ultimeSpese.forEach(function(e) { %>
            <div class="expense-item squircle-sm">
              <div class="expense-meta">
                <span class="expense-cat"><%= e.categoria %><%= e.sottocategoria ? ' → ' + e.sottocategoria : '' %></span>
                <span class="expense-name"><%= e.note && e.note.length ? e.note : e.categoria %></span>
                <span class="expense-sub"><%= new Date(e.data_spesa).toLocaleDateString('it-IT') %> · <%= e.inserito_da %> → <%= e.per_conto_di %></span>
              </div>
              <div class="expense-amount" style="color: <%= e.tipo === 'ingresso' ? '#148c50' : 'var(--danger)' %>;">
                <%= e.tipo === 'ingresso' ? '+' : '−' %> € <%= e.importo.toFixed(2) %>
              </div>
            </div>
          <% }); %>
        <% } %>
      </div>
    </main>
  </div>

  <!-- MODAL POPUP PER GRAFICI -->
<div id="chart-modal" class="chart-modal-overlay" style="display: none;">
  <div class="chart-modal-content">
    <div class="chart-modal-header">
      <h3 id="chart-modal-title">Dettagli Grafico</h3>
      <button id="chart-modal-close" class="chart-modal-close-btn">&times;</button>
    </div>
    <div class="chart-modal-body">
      <canvas id="chart-modal-canvas"></canvas>
    </div>
    <div class="chart-modal-footer" id="chart-modal-details">
      <!-- I dettagli verranno inseriti qui via JS -->
    </div>
  </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.4/chart.umd.min.js"
        onerror="var s=document.createElement('script');s.src='https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js';document.head.appendChild(s);"></script>

<script>
(function initCharts() {
  if (typeof Chart === 'undefined') {
    setTimeout(initCharts, 200);
    return;
  }

  // Colori tema
  function getThemeColors() {
    var dark = document.documentElement.getAttribute('data-theme') === 'dark';
    return {
      text: dark ? '#f5f5f5' : '#0a0a0a',
      grid: dark ? '#2a2a2e' : '#e3e3e6',
      palette: dark
        ? ['#ffffff', '#c9c9cf', '#9a9aa0', '#6b6b70', '#4a4a4f', '#2a2a2e', '#1a1a1c']
        : ['#0a0a0a', '#3a3a3d', '#5a5a5e', '#7a7a7e', '#9a9a9e', '#bdbdbf', '#e0e0e2']
    };
  }
  
  var colors = getThemeColors();
  const catData = <%- JSON.stringify(chartCategorie) %>;
  const giornoData = <%- JSON.stringify(chartGiornaliero) %>;

  // 1. GRAFICI NORMALI (Nella pagina)
  new Chart(document.getElementById('chartCategorie'), {
    type: 'doughnut',
    data: {
      labels: catData.labels,
      datasets: [{ data: catData.data, backgroundColor: colors.palette, borderWidth: 0 }]
    },
    options: {
      plugins: { legend: { position: 'bottom', labels: { color: colors.text, boxWidth: 12, padding: 14 } } }
    }
  });

  new Chart(document.getElementById('chartGiornaliero'), {
    type: 'bar',
    data: {
      labels: giornoData.labels,
      datasets: [
        { label: 'Entrate (€)', data: giornoData.dataIngressi, backgroundColor: colors.palette[1] || colors.text, borderRadius: 6 },
        { label: 'Uscite (€)', data: giornoData.dataUscite, backgroundColor: colors.text, borderRadius: 6 }
      ]
    },
    options: {
      plugins: { legend: { display: true, labels: { color: colors.text, boxWidth: 12 } } },
      scales: {
        x: { ticks: { color: colors.text }, grid: { display: false } },
        y: { ticks: { color: colors.text }, grid: { color: colors.grid } }
      }
    }
  });

  // 2. LOGICA POPUP / MODAL
  const modal = document.getElementById('chart-modal');
  const modalTitle = document.getElementById('chart-modal-title');
  const modalCanvas = document.getElementById('chart-modal-canvas');
  const modalDetails = document.getElementById('chart-modal-details');
  const modalCloseBtn = document.getElementById('chart-modal-close');
  let modalChartInstance = null;

  function openChartModal(type) {
    modal.style.display = 'flex';
    
    if (modalChartInstance) modalChartInstance.destroy();

    if (type === 'categorie') {
      modalTitle.textContent = 'Dettaglio: Spese per categoria';
      modalDetails.textContent = `Totale categorie monitorate: ${catData.labels.length} | Clicca fuori o premi ESC per chiudere`;
      
      modalChartInstance = new Chart(modalCanvas, {
        type: 'doughnut',
        data: {
          labels: catData.labels,
          datasets: [{ data: catData.data, backgroundColor: colors.palette, borderWidth: 0 }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: true,
          plugins: { 
            legend: { position: 'right', labels: { color: colors.text, boxWidth: 16, padding: 20, font: { size: 14 } } },
            tooltip: { bodyFont: { size: 14 }, titleFont: { size: 16 }, padding: 12 }
          }
        }
      });
    } else if (type === 'giornaliero') {
      modalTitle.textContent = 'Dettaglio: Andamento giornaliero';
      modalDetails.textContent = `Giorni analizzati: ${giornoData.labels.length} | Clicca fuori o premi ESC per chiudere`;
      
      modalChartInstance = new Chart(modalCanvas, {
        type: 'bar',
        data: {
          labels: giornoData.labels,
          datasets: [
            { label: 'Entrate (€)', data: giornoData.dataIngressi, backgroundColor: colors.palette[1] || colors.text, borderRadius: 8 },
            { label: 'Uscite (€)', data: giornoData.dataUscite, backgroundColor: colors.text, borderRadius: 8 }
          ]
        },
        options: {
          responsive: true,
          maintainAspectRatio: true,
          plugins: { 
            legend: { display: true, labels: { color: colors.text, boxWidth: 16, font: { size: 14 } } },
            tooltip: { bodyFont: { size: 14 }, titleFont: { size: 16 }, padding: 12 }
          },
          scales: {
            x: { ticks: { color: colors.text, font: { size: 13 } }, grid: { display: false } },
            y: { ticks: { color: colors.text, font: { size: 13 } }, grid: { color: colors.grid } }
          }
        }
      });
    }
  }

  function closeChartModal() {
    modal.style.display = 'none';
    if (modalChartInstance) {
      modalChartInstance.destroy();
      modalChartInstance = null;
    }
  }

  modalCloseBtn.addEventListener('click', closeChartModal);
  modal.addEventListener('click', function(e) {
    if (e.target === modal) closeChartModal();
  });
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape' && modal.style.display === 'flex') closeChartModal();
  });

  var buttons = document.querySelectorAll('.chart-fullscreen');
  buttons.forEach(function(b){
    b.addEventListener('click', function(ev){
      var card = ev.target.closest('.chart-card');
      if (!card) return;
      var chartType = card.getAttribute('data-chart');
      openChartModal(chartType);
    });
  });

})();
</script>
  
</body>
</html>