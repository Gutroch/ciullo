<!DOCTYPE html>
<html lang="it">
<head>
  <%- include('partials/head', { title: 'Nuovo · CiulloTracker' }) %>
</head>
<body>
  <%- include('partials/splash') %>
  <div class="app-shell">
    <%- include('partials/nav', { user: user, active: 'new' }) %>

    <main class="main-content">
      <div class="page-title">Nuovo</div>
      <div class="page-subtitle">Registra in pochi secondi</div>

      <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
      <% if (success) { %><div class="alert alert-success"><%= success %></div><% } %>

      <div class="card squircle" style="max-width: 480px;">
        <form action="/expenses" method="POST" id="expenseForm">

          <div class="field">
            <label>Tipo</label>
            <div class="segmented">
              <label class="segmented-item"><input type="radio" name="tipo" value="uscita" checked> Spesa</label>
              <label class="segmented-item"><input type="radio" name="tipo" value="ingresso"> Ingresso</label>
            </div>
          </div>

          <div class="field">
            <label for="importo">Importo (€)</label>
            <input class="input input-amount" type="number" step="0.01" min="0.01" inputmode="decimal" id="importo" name="importo" placeholder="0.00" required />
          </div>

          <div class="form-row">
            <div class="field">
              <label for="data_spesa">Data</label>
              <input class="input" type="date" id="data_spesa" name="data_spesa" value="<%= oggi %>" required />
            </div>
            <div class="field">
              <label for="categoria">Categoria</label>
              <select class="input" id="categoria" name="categoria">
                <% categorie.forEach(function(c) { %>
                  <option value="<%= c %>"><%= c %></option>
                <% }); %>
              </select>
            </div>
          </div>

          <div class="field">
            <label for="note">Note (opzionale)</label>
            <input class="input" type="text" id="note" name="note" placeholder="Es. Spesa al supermercato" />
          </div>

          <!-- Sezione Avanzate: se non toccata, si assume "da me, per me" -->
          <div class="accordion">
            <div class="accordion-header" id="advToggle">
              <span>Opzioni avanzate</span>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
            </div>
            <div class="accordion-body" id="advBody">
              <div class="field">
                <label for="inserito_da">Inserito da</label>
                <select class="input" id="inserito_da" name="inserito_da">
                  <option value="">— Io stesso (<%= user.username %>) —</option>
                  <% utenti.forEach(function(u) { %>
                    <option value="<%= u.username %>"><%= u.username %></option>
                  <% }); %>
                </select>
              </div>
              <div class="field" style="margin-bottom:0;">
                <label for="per_conto_di">Per conto di</label>
                <select class="input" id="per_conto_di" name="per_conto_di">
                  <option value="">— Me stesso (<%= user.username %>) —</option>
                  <% utenti.forEach(function(u) { %>
                    <option value="<%= u.username %>"><%= u.username %></option>
                  <% }); %>
                  <option value="Tutta la famiglia">Tutta la famiglia</option>
                </select>
              </div>
            </div>
          </div>

          <button type="submit" class="btn btn-primary btn-block" id="submitBtn">Salva Spesa</button>
        </form>
      </div>
    </main>
  </div>

  <script>
    // Gestione apertura/chiusura accordion "Opzioni avanzate"
    (function () {
      var header = document.getElementById('advToggle');
      var body = document.getElementById('advBody');
      header.addEventListener('click', function () {
        header.classList.toggle('open');
        body.classList.toggle('open');
      });
    })();
    // Gestione tipo Spesa/Ingresso
    (function(){
      var radios = document.querySelectorAll('input[name="tipo"]');
      var submit = document.getElementById('submitBtn');
      var amount = document.getElementById('importo');
      function update() {
        var v = document.querySelector('input[name="tipo"]:checked').value;
        if (v === 'ingresso') {
          submit.textContent = 'Salva Ingresso';
          amount.style.color = 'var(--accent)';
        } else {
          submit.textContent = 'Salva Spesa';
          amount.style.color = '';
        }
      }
      radios.forEach(function(r){ r.addEventListener('change', update); });
      update();
    })();
  </script>
</body>
</html>
