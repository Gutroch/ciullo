<!DOCTYPE html>
<html lang="it">
<head>
  <%- include('partials/head', { title: 'Ricorrenti · CiulloTracker' }) %>
</head>
<body>
  <%- include('partials/splash') %>
  <div class="app-shell">
    <%- include('partials/nav', { user: user, active: 'recurring' }) %>

    <main class="main-content">
      <div class="page-title">Spese ricorrenti</div>
      <div class="page-subtitle">Rate, bollette e abbonamenti che tornano periodicamente: te li ricordiamo e li registriamo da soli quando arriva la scadenza.</div>

      <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
      <% if (success) { %><div class="alert alert-success"><%= success %></div><% } %>

      <div class="grid grid-2" style="align-items:start; margin-bottom: 20px;">
        <!-- Form creazione -->
        <div class="card squircle">
          <div class="chart-title">Nuova voce ricorrente</div>
          <form action="/recurring" method="POST" id="recurringForm">

            <div class="field">
              <label>Tipo</label>
              <div class="segmented">
                <label class="segmented-item"><input type="radio" name="tipo" value="uscita" checked> Spesa</label>
                <label class="segmented-item"><input type="radio" name="tipo" value="ingresso"> Entrata</label>
              </div>
            </div>

            <div class="field">
              <label for="descrizione">Descrizione</label>
              <input class="input" type="text" id="descrizione" name="descrizione" placeholder="Es. Rata condominio" required />
            </div>

            <div class="form-row">
              <div class="field">
                <label for="importo">Importo (€)</label>
                <input class="input input-amount" type="number" step="0.01" min="0.01" inputmode="decimal" id="importo" name="importo" placeholder="0.00" required />
              </div>
              <div class="field">
                <label for="giorno">Giorno del mese</label>
                <input class="input" type="number" min="1" max="31" id="giorno" name="giorno" value="1" required />
              </div>
            </div>

            <div class="field">
              <label for="categoria">Categoria</label>
              <select class="input" id="categoria" name="categoria">
                <!-- Popolato via JS -->
              </select>
            </div>

            <div class="field" id="sottocategoriaGroup">
              <label for="sottocategoria">Sottocategoria</label>
              <select class="input" id="sottocategoria" name="sottocategoria">
                <option value="">— Nessuna —</option>
              </select>
            </div>

            <div class="field">
              <label>Ricorrenza</label>
              <div class="segmented">
                <label class="segmented-item"><input type="radio" name="ricorrenza" value="mensile" id="ricMensile" checked> Ogni mese</label>
                <label class="segmented-item"><input type="radio" name="ricorrenza" value="mesi" id="ricMesi"> Mesi specifici</label>
              </div>
            </div>

            <div class="field" id="mesiBox" style="display:none;">
              <label>Seleziona i mesi</label>
              <div class="months-grid">
                <% var mesiNomi = ['Gen','Feb','Mar','Apr','Mag','Giu','Lug','Ago','Set','Ott','Nov','Dic']; %>
                <% mesiNomi.forEach(function(m, i) { %>
                  <label class="segmented-item month-check"><input type="checkbox" name="mesi" value="<%= i+1 %>"> <%= m %></label>
                <% }); %>
              </div>
            </div>

            <!-- Sezione Avanzate -->
            <div class="accordion">
              <div class="accordion-header" id="advToggle">
                <span>Opzioni avanzate</span>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
              </div>
              <div class="accordion-body" id="advBody">
                <div class="field">
                  <label for="inserito_da">Inserito da</label>
                  <select class="input" id="inserito_da" name="inserito_da">
                    <option value="">— Io stesso (<%= user.username %>) —</option>
                    <% utenti.forEach(function(u) { %>
                      <option value="<%= u.username %>"><%= u.username %></option>
                    <% }); %>
                  </select>
                </div>
                <div class="field" style="margin-bottom:0;">
                  <label for="per_conto_di">Per conto di</label>
                  <select class="input" id="per_conto_di" name="per_conto_di">
                    <option value="">— Me stesso (<%= user.username %>) —</option>
                    <% utenti.forEach(function(u) { %>
                      <option value="<%= u.username %>"><%= u.username %></option>
                    <% }); %>
                    <option value="Tutta la famiglia">Tutta la famiglia</option>
                  </select>
                </div>
              </div>
            </div>

            <button type="submit" class="btn btn-primary btn-block">Salva voce ricorrente</button>
          </form>
        </div>

        <!-- Elenco voci ricorrenti -->
        <div class="card squircle">
          <div class="chart-title">Voci attive e disattivate</div>
          <% if (voci.length === 0) { %>
            <div class="empty-state">Nessuna spesa ricorrente configurata.</div>
          <% } else { %>
            <% voci.forEach(function(r) { %>
              <div class="expense-item squircle-sm">
                <div class="expense-meta">
                  <span class="expense-cat"><%= r.categoria %><%= r.sottocategoria ? ' → ' + r.sottocategoria : '' %><%= r.attivo ? '' : ' · disattivata' %></span>
                  <span class="expense-name"><%= r.descrizione %></span>
                  <span class="expense-sub">
                    Giorno <%= r.giorno %> ·
                    <%= r.ricorrenza === 'mensile' ? 'Ogni mese' : 'Mesi: ' + r.mesi.map(function(m){ return mesiNomi[m-1]; }).join(', ') %>
                  </span>
                </div>
                <div style="display:flex; align-items:center; gap:10px;">
                  <div class="expense-amount" style="color: <%= r.tipo === 'ingresso' ? '#148c50' : 'var(--danger)' %>;">
                    <%= r.tipo === 'ingresso' ? '+' : '−' %> € <%= r.importo.toFixed(2) %>
                  </div>
                  <form action="/recurring/<%= r.id %>/toggle" method="POST">
                    <button type="submit" class="btn btn-secondary btn-sm"><%= r.attivo ? 'Disattiva' : 'Attiva' %></button>
                  </form>
                  <form action="/recurring/<%= r.id %>/delete" method="POST" onsubmit="return confirm('Eliminare questa voce ricorrente?');">
                    <button type="submit" class="btn btn-danger btn-sm">Elimina</button>
                  </form>
                </div>
              </div>
            <% }); %>
          <% } %>
        </div>
      </div>
    </main>
  </div>

  <%- include('partials/footer', { user: user }) %>

  <script>
    const categorieSpese = <%- JSON.stringify(categorieSpese) %>;
    const categorieEntrate = <%- JSON.stringify(categorieEntrate) %>;

    // Gestione tipo e categorie
    (function() {
      const tipoRadios = document.querySelectorAll('input[name="tipo"]');
      const categoriaSelect = document.getElementById('categoria');
      const sottocategoriaSelect = document.getElementById('sottocategoria');
      const sottocategoriaGroup = document.getElementById('sottocategoriaGroup');

      function populateCategorie(tipo) {
        const options = tipo === 'ingresso' ? categorieEntrate : Object.keys(categorieSpese);
        categoriaSelect.innerHTML = '';
        options.forEach(c => {
          const opt = document.createElement('option');
          opt.value = c;
          opt.textContent = c;
          categoriaSelect.appendChild(opt);
        });
        // Dopo popolamento, aggiorna sottocategorie
        updateSottocategorie();
      }

      function updateSottocategorie() {
        const tipo = document.querySelector('input[name="tipo"]:checked').value;
        if (tipo === 'ingresso') {
          sottocategoriaGroup.style.display = 'none';
          return;
        }
        sottocategoriaGroup.style.display = 'block';
        const cat = categoriaSelect.value;
        const sottos = categorieSpese[cat] || [];
        sottocategoriaSelect.innerHTML = '<option value="">— Nessuna —</option>';
        sottos.forEach(s => {
          const opt = document.createElement('option');
          opt.value = s;
          opt.textContent = s;
          sottocategoriaSelect.appendChild(opt);
        });
      }

      tipoRadios.forEach(r => {
        r.addEventListener('change', function() {
          populateCategorie(this.value);
        });
      });

      categoriaSelect.addEventListener('change', updateSottocategorie);

      // Inizializza
      const initialTipo = document.querySelector('input[name="tipo"]:checked').value;
      populateCategorie(initialTipo);
    })();

    // Accordion opzioni avanzate
    (function () {
      var header = document.getElementById('advToggle');
      var body = document.getElementById('advBody');
      header.addEventListener('click', function () {
        header.classList.toggle('open');
        body.classList.toggle('open');
      });
    })();

    // Mostra/nasconde la selezione mesi
    (function () {
      var mensile = document.getElementById('ricMensile');
      var mesiRadio = document.getElementById('ricMesi');
      var mesiBox = document.getElementById('mesiBox');
      function update() {
        mesiBox.style.display = mesiRadio.checked ? 'block' : 'none';
      }
      mensile.addEventListener('change', update);
      mesiRadio.addEventListener('change', update);
      update();
    })();
  </script>
</body>
</html>