<!DOCTYPE html>
<html lang="it">
<head>
  <%- include('partials/head', { title: 'Jonny · CiulloTracker' }) %>
</head>
<body>
  <%- include('partials/splash') %>
  <div class="app-shell">
    <%- include('partials/nav', { user: user, active: 'jonny' }) %>

    <main class="main-content">
      <div class="page-title">Jonny</div>
      <div class="page-subtitle">Il tuo assistente per le spese</div>

      <div class="card jonny-hero">
        <div class="avatar-feature" data-avatar-mount data-avatar-size="100%" aria-hidden="true"></div>
        <div>
          <div class="jonny-hero-title">Ciao, sono Jonny 👋</div>
          <div class="jonny-hero-subtitle">Chiedimi pure delle vostre spese, del budget o di come usare l'app: rispondo leggendo i vostri dati reali.</div>
          <div class="jonny-hero-status"><span class="dot"></span> Online</div>
        </div>
      </div>

      <div class="card jonny-chat-card">
        <div class="jonny-messages" id="jonnyMessages">
          <div class="jonny-msg jonny-msg-bot">
            <div class="jonny-msg-bubble">Ciao! Sono Jonny 👋 Chiedimi pure qualcosa sulle vostre spese, sul budget o su come usare l'app.</div>
          </div>
        </div>
        <form class="jonny-input-row" id="jonnyForm">
          <textarea class="input" id="jonnyInput" rows="1" placeholder="Scrivi un messaggio a Jonny…" autocomplete="off" maxlength="500" required></textarea>
          <button type="submit" class="btn btn-primary" id="jonnySend">Invia</button>
        </form>
      </div>
    </main>
  </div>

  <!-- Popup di conferma: appare SOLO quando Jonny propone di scrivere/modificare/eliminare dati.
       Nessuna scrittura reale avviene finché l'utente non preme "Conferma". -->
  <div class="modal-overlay" id="jonnyConfirmOverlay">
    <div class="modal-content" role="alertdialog" aria-labelledby="jonnyConfirmTitle">
      <h3 id="jonnyConfirmTitle">⚠️ Conferma richiesta</h3>
      <div class="field">
        <p id="jonnyConfirmText" style="margin:0; line-height:1.5;"></p>
      </div>
      <p style="margin:0 0 0.5rem 0; font-size:0.85rem; color:var(--text-soft);">Jonny non modifica mai i tuoi dati senza il tuo ok esplicito.</p>
      <div class="modal-actions">
        <button type="button" class="btn btn-secondary" id="jonnyConfirmCancel">Annulla</button>
        <button type="button" class="btn btn-primary" id="jonnyConfirmOk">Conferma</button>
      </div>
    </div>
  </div>

  <script>
    window.CiulloAvatarContext = {
      page: 'jonny',
      mood: 'greet'
    };
  </script>

  <%- include('partials/footer', { user: user }) %>

  <script src="/js/jonny-chat.js" defer></script>
</body>
</html>
