<!DOCTYPE html>
<html lang="it">
<head><%- include('partials/head', { title: 'Cambia password · CiulloTracker' }) %></head>
<body>
  <div class="login-screen">
    <div class="login-card squircle-lg">
      <div class="login-title">Cambia password</div>
      <div class="login-subtitle">Per continuare devi impostare una nuova password.</div>
      <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
      <form action="/change-password" method="POST">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="field"><label for="password">Nuova password</label><input class="input" id="password" name="password" type="password" minlength="12" required autofocus></div>
        <button type="submit" class="btn btn-primary btn-block">Salva password</button>
      </form>
    </div>
  </div>
</body>
</html>
