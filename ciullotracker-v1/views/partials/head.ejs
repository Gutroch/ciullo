<meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=yes">
  <meta name="theme-color" content="#FFFFFF" id="theme-color-meta" />
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="apple-mobile-web-app-title" content="CiulloTracker">
  <link rel="manifest" href="/manifest.json">
  <link rel="icon" href="/icons/favicon-v2.svg" />
  <link rel="apple-touch-icon" sizes="192x192" href="/icons/icon-192-v2.svg">
  <title><%= typeof title !== 'undefined' ? title : 'CiulloTracker' %></title>
  <link rel="stylesheet" href="/css/style.css" />
  <script>
    // Applica subito il tema salvato per evitare il "flash" bianco/nero al caricamento
    (function () {
      var saved = localStorage.getItem('hbt-theme');
      var theme = saved || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      document.documentElement.setAttribute('data-theme', theme);
      // aggiorna il meta theme-color in base al tema
      var meta = document.getElementById('theme-color-meta');
      if (meta) meta.setAttribute('content', theme === 'dark' ? '#131314' : '#FFFFFF');
    })();
  </script>
  <script defer src="/js/pwa.js"></script>
  <script defer src="/js/calc-input.js"></script>
  <script defer src="/js/ui-effects.js"></script>
