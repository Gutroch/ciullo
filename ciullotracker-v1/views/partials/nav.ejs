<%
  var isActive = function (name) { return typeof active !== 'undefined' && active === name; };
  var isAdmin = user && user.ruolo === 'admin';
%>

<!-- ============================================================
     NAVIGATION RAIL — desktop
     ============================================================ -->
<aside class="sidebar" id="sidebar">
  <div class="brand">
    <img src="/icons/favicon.svg" alt="Logo" class="brand-logo" />
    <span>CiulloTracker</span>
  </div>

  <nav class="nav-links">
    <a href="/" class="nav-link <%= isActive('dashboard') ? 'active' : '' %>">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="9" rx="2"/><rect x="14" y="3" width="7" height="5" rx="2"/><rect x="14" y="12" width="7" height="9" rx="2"/><rect x="3" y="16" width="7" height="5" rx="2"/></svg>
      Dashboard
    </a>
    <a href="/expenses/new" class="nav-link <%= isActive('new') ? 'active' : '' %>">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>
      Nuovo
    </a>
    <a href="/history" class="nav-link <%= isActive('history') ? 'active' : '' %>">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 3v18h18"/><path d="M18 17V9M13 17V5M8 17v-4"/></svg>
      Storico &amp; Export
    </a>
    <a href="/recurring" class="nav-link <%= isActive('recurring') ? 'active' : '' %>">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 3"/></svg>
      Ricorrenti
    </a>
    <a href="/budget" class="nav-link <%= isActive('budget') ? 'active' : '' %>">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M12 2v4M12 22v-4M4 8l8-4 8 4M4 16l8 4 8-4M4 12l8 4 8-4"/>
      </svg>
      Annuali
    </a>
    <a href="/promemoria" class="nav-link <%= isActive('promemoria') ? 'active' : '' %>">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
        <line x1="16" y1="2" x2="16" y2="6"/>
        <line x1="8" y1="2" x2="8" y2="6"/>
        <line x1="3" y1="10" x2="21" y2="10"/>
        <circle cx="12" cy="15" r="1"/>
        <circle cx="16" cy="15" r="1"/>
        <circle cx="8" cy="15" r="1"/>
      </svg>
      Promemoria
    </a>
    <% if (isAdmin) { %>
    <a href="/admin" class="nav-link <%= isActive('admin') ? 'active' : '' %>">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 4-6 8-6s8 2 8 6"/></svg>
      Pannello Admin
      <% if (typeof maintenanceActive !== 'undefined' && maintenanceActive) { %><span class="maint-dot" title="Manutenzione attiva"></span><% } %>
    </a>
    <% } %>
  </nav>

  <div class="sidebar-footer">
    <div class="user-chip">
      <div class="user-avatar"><%= user ? user.username.charAt(0) : '?' %></div>
      <div>
        <div style="font-weight:600; font-size:0.86rem;"><%= user ? user.username : '' %></div>
        <div class="role-badge"><%= user ? user.ruolo : '' %></div>
      </div>
    </div>
    <button class="btn btn-secondary btn-sm theme-toggle-btn" id="themeToggle" style="width:100%; justify-content:flex-start; padding-left:14px; border-radius:var(--radius-pill);" type="button">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="5"/><path d="M12 1v2M12 21v2M4.2 4.2l1.4 1.4M18.4 18.4l1.4 1.4M1 12h2M21 12h2M4.2 19.8l1.4-1.4M18.4 5.6l1.4-1.4"/></svg>
      <span style="margin-left:6px;">Cambia tema</span>
    </button>
    <button class="btn btn-primary btn-sm btn-block" id="pwaInstallBtn" type="button" style="display:none; margin-bottom:8px;">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="vertical-align:-2px; margin-right:6px;"><path d="M12 3v12"/><path d="m7 10 5 5 5-5"/><path d="M5 21h14"/></svg>
      Installa App
    </button>
    <form action="/logout" method="POST">
      <button type="submit" class="btn btn-secondary btn-sm btn-block">Esci</button>
    </form>
  </div>
</aside>

<!-- ============================================================
     TOP APP BAR — mobile
     ============================================================ -->
<div class="topbar">
  <div class="brand" style="padding:0;"><img src="/icons/favicon.svg" alt="Logo" class="brand-logo" /><span>CiulloTracker</span></div>
  <div class="topbar-actions">
    <button class="theme-toggle-btn" id="themeToggleMobile" type="button" aria-label="Cambia tema">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="5"/><path d="M12 1v2M12 21v2M4.2 4.2l1.4 1.4M18.4 18.4l1.4 1.4M1 12h2M21 12h2M4.2 19.8l1.4-1.4M18.4 5.6l1.4-1.4"/></svg>
    </button>
    <button class="account-btn" id="accountBtn" type="button" aria-label="Altro">
      <div class="topbar-avatar"><%= user ? user.username.charAt(0) : '?' %></div>
    </button>
  </div>
</div>

<!-- ============================================================
     BOTTOM NAVIGATION BAR — Material 3, sostituisce il drawer su mobile
     ============================================================ -->
<nav class="bottom-nav" id="bottomNav" aria-label="Navigazione principale">
  <a href="/" class="bottom-nav-item <%= isActive('dashboard') ? 'active' : '' %>">
    <span class="bn-icon-wrap"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="9" rx="2"/><rect x="14" y="3" width="7" height="5" rx="2"/><rect x="14" y="12" width="7" height="9" rx="2"/><rect x="3" y="16" width="7" height="5" rx="2"/></svg></span>
    <span>Dashboard</span>
  </a>
  <a href="/history" class="bottom-nav-item <%= isActive('history') ? 'active' : '' %>">
    <span class="bn-icon-wrap"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 3v18h18"/><path d="M18 17V9M13 17V5M8 17v-4"/></svg></span>
    <span>Storico</span>
  </a>
  <a href="/expenses/new" class="bottom-nav-fab">
    <span class="fab-circle"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M12 5v14M5 12h14"/></svg></span>
    <span>Nuovo</span>
  </a>
  <a href="/budget" class="bottom-nav-item <%= isActive('budget') ? 'active' : '' %>">
    <span class="bn-icon-wrap"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2v4M12 22v-4M4 8l8-4 8 4M4 16l8 4 8-4M4 12l8 4 8-4"/></svg></span>
    <span>Annuali</span>
  </a>
  <button type="button" class="bottom-nav-item <%= (isActive('recurring') || isActive('promemoria') || isActive('admin')) ? 'active' : '' %>" id="moreNavBtn">
    <span class="bn-icon-wrap"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="5" cy="12" r="1.6"/><circle cx="12" cy="12" r="1.6"/><circle cx="19" cy="12" r="1.6"/></svg></span>
    <span>Altro</span>
  </button>
</nav>

<!-- ============================================================
     SHEET — menu "Altro" (overflow mobile) + profilo/account
     ============================================================ -->
<div class="sheet-overlay" id="moreSheetOverlay">
  <div class="sheet" id="moreSheet" role="dialog" aria-label="Altre opzioni">
    <div class="sheet-handle"></div>

    <div class="sheet-user">
      <div class="user-avatar" style="width:38px;height:38px;"><%= user ? user.username.charAt(0) : '?' %></div>
      <div>
        <div style="font-weight:600; font-size:0.9rem;"><%= user ? user.username : '' %></div>
        <div class="role-badge"><%= user ? user.ruolo : '' %></div>
      </div>
    </div>

    <div class="sheet-section-title">Sezioni</div>
    <a href="/recurring" class="sheet-item <%= isActive('recurring') ? 'active' : '' %>">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 3"/></svg>
      Spese ricorrenti
    </a>
    <a href="/promemoria" class="sheet-item <%= isActive('promemoria') ? 'active' : '' %>">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
        <line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/>
        <circle cx="12" cy="15" r="1"/><circle cx="16" cy="15" r="1"/><circle cx="8" cy="15" r="1"/>
      </svg>
      Promemoria
    </a>
    <% if (isAdmin) { %>
    <a href="/admin" class="sheet-item <%= isActive('admin') ? 'active' : '' %>">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 4-6 8-6s8 2 8 6"/></svg>
      Pannello Admin
      <% if (typeof maintenanceActive !== 'undefined' && maintenanceActive) { %><span class="maint-dot" title="Manutenzione attiva"></span><% } %>
    </a>
    <% } %>

    <div class="sheet-divider"></div>

    <div class="sheet-section-title">Preferenze</div>
    <button type="button" class="sheet-item" id="themeToggleSheet">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="5"/><path d="M12 1v2M12 21v2M4.2 4.2l1.4 1.4M18.4 18.4l1.4 1.4M1 12h2M21 12h2M4.2 19.8l1.4-1.4M18.4 5.6l1.4-1.4"/></svg>
      Cambia tema
    </button>
    <button type="button" class="sheet-item" id="pwaInstallBtnSheet" style="display:none;">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 3v12"/><path d="m7 10 5 5 5-5"/><path d="M5 21h14"/></svg>
      Installa App
    </button>

    <div class="sheet-divider"></div>

    <form action="/logout" method="POST">
      <button type="submit" class="sheet-item danger">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><path d="m16 17 5-5-5-5M21 12H9"/></svg>
        Esci
      </button>
    </form>
  </div>
</div>

<script>
  // Apertura/chiusura sheet "Altro" (mobile) — sostituisce il vecchio drawer laterale
  (function () {
    var overlay = document.getElementById('moreSheetOverlay');
    var moreBtn = document.getElementById('moreNavBtn');
    var accountBtn = document.getElementById('accountBtn');

    function openSheet() { overlay.classList.add('show'); }
    function closeSheet() { overlay.classList.remove('show'); }

    if (moreBtn) moreBtn.addEventListener('click', openSheet);
    if (accountBtn) accountBtn.addEventListener('click', openSheet);
    if (overlay) {
      overlay.addEventListener('click', function (e) {
        if (e.target === overlay) closeSheet();
      });
    }
  })();

  // Toggle tema chiaro/scuro con salvataggio in localStorage
  (function () {
    function applyToggle() {
      var current = document.documentElement.getAttribute('data-theme');
      var next = current === 'dark' ? 'light' : 'dark';
      document.documentElement.setAttribute('data-theme', next);
      localStorage.setItem('hbt-theme', next);
    }
    var t1 = document.getElementById('themeToggle');
    var t2 = document.getElementById('themeToggleMobile');
    var t3 = document.getElementById('themeToggleSheet');
    if (t1) t1.addEventListener('click', applyToggle);
    if (t2) t2.addEventListener('click', applyToggle);
    if (t3) t3.addEventListener('click', applyToggle);
  })();

  // Pulsante "Installa App" (PWA) — versione sidebar desktop e sheet mobile
  (function () {
    var installBtn = document.getElementById('pwaInstallBtn');
    var installBtnSheet = document.getElementById('pwaInstallBtnSheet');
    if (!installBtn && !installBtnSheet) return;

    function isStandalone() {
      return window.matchMedia('(display-mode: standalone)').matches ||
        window.navigator.standalone === true;
    }

    if (isStandalone()) return;

    function showButton(e) {
      window.deferredPWAInstall = e;
      if (installBtn) installBtn.style.display = 'flex';
      if (installBtnSheet) installBtnSheet.style.display = 'flex';
    }

    if (window.deferredPWAInstall) {
      showButton(window.deferredPWAInstall);
    }
    window.addEventListener('beforeinstallprompt', showButton);

    function doInstall() {
      var promptEvent = window.deferredPWAInstall;
      if (!promptEvent) return;
      if (installBtn) installBtn.style.display = 'none';
      if (installBtnSheet) installBtnSheet.style.display = 'none';
      promptEvent.prompt();
      promptEvent.userChoice.finally(function () {
        window.deferredPWAInstall = null;
      });
    }
    if (installBtn) installBtn.addEventListener('click', doInstall);
    if (installBtnSheet) installBtnSheet.addEventListener('click', doInstall);

    window.addEventListener('appinstalled', function () {
      if (installBtn) installBtn.style.display = 'none';
      if (installBtnSheet) installBtnSheet.style.display = 'none';
      window.deferredPWAInstall = null;
    });
  })();
</script>
