<%# Splash CiulloTracker — ingresso a sipario: l'anello si disegna, il nome sale lettera per lettera,
    poi lo schermo si chiude a iride sul logo e scopre l'app. Autonomo: CSS e JS in questo file. %>
<style id="sp-style">
  .sp {
    position: fixed; inset: 0; z-index: 9999;
    display: flex; align-items: center; justify-content: center;
    background: var(--canvas);
    color: var(--text);
    overflow: hidden;
    padding: env(safe-area-inset-top) env(safe-area-inset-right) env(safe-area-inset-bottom) env(safe-area-inset-left);
    clip-path: circle(150% at 50% 46%);
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }
  html.sp-lock, html.sp-lock body { overflow: hidden; }

  /* alone morbido dietro al logo */
  .sp-glow {
    position: absolute; inset: 0;
    background: radial-gradient(circle at 50% 44%, rgb(var(--ink) / .07), transparent 55%);
    animation: sp-glow-in 1.1s var(--ease-enter) both;
  }
  .sp-center { position: relative; display: flex; flex-direction: column; align-items: center; text-align: center; padding: 0 1.5rem; transform: translateY(-2vh); }

  /* logo: i due archi si disegnano mentre l'anello ruota in posizione */
  .sp-logo { position: relative; width: clamp(5.5rem, 26vw, 7.5rem); aspect-ratio: 1; }
  .sp-logo svg { position: relative; width: 100%; height: 100%; display: block; overflow: visible; }
  .sp-ring { transform-box: view-box; transform-origin: center; animation: sp-spin 1.15s var(--ease-enter) .05s both; }
  .sp-arc { fill: none; stroke: currentColor; stroke-linecap: round; }
  .sp-arc-thin  { stroke-width: 8;  stroke-dasharray: 107.09 219.63; animation: sp-draw-thin .75s var(--ease-enter) .1s both; }
  .sp-arc-thick { stroke-width: 22; stroke-dasharray: 123.43 203.30; animation: sp-draw-thick .7s var(--ease-enter) .32s both; }
  .sp-ripple {
    position: absolute; inset: 14%; border-radius: 50%;
    border: 1.5px solid currentColor; opacity: 0;
    animation: sp-ripple .9s var(--ease-enter) .95s both;
  }

  /* nome: "Ciullo" pieno, "Tracker" leggero, lettere che salgono sfocate */
  .sp-word { margin: clamp(1.1rem, 4vh, 1.7rem) 0 0; display: flex; font-size: clamp(1.7rem, 7.4vw, 2.5rem); line-height: 1.1; letter-spacing: -.035em; }
  .sp-word span { display: inline-block; animation: sp-letter .62s var(--ease-enter) calc(.5s + var(--i) * .045s) both; }
  .sp-word .sp-a span { font-weight: 800; }
  .sp-word .sp-b span { font-weight: 350; opacity: .78; }
  .sp-word .sp-a, .sp-word .sp-b { display: inline-flex; }

  .sp-tag { margin: .7rem 0 0; font-size: .875rem; letter-spacing: .01em; color: var(--text-soft); animation: sp-rise .6s var(--ease-enter) 1.05s both; }

  /* barra di avanzamento e suggerimento */
  .sp-bar { position: absolute; left: 50%; bottom: calc(2.6rem + env(safe-area-inset-bottom)); width: min(11rem, 40vw); height: 2px; margin-left: calc(min(11rem, 40vw) / -2); background: rgb(var(--ink) / .12); border-radius: 2px; overflow: hidden; animation: sp-rise .5s ease .2s both; }
  .sp-bar i { display: block; height: 100%; background: var(--text); transform-origin: left; animation: sp-fill 1.7s cubic-bezier(.4, 0, .2, 1) .15s both; }
  .sp-hint { position: absolute; left: 0; right: 0; bottom: calc(1.1rem + env(safe-area-inset-bottom)); text-align: center; font-size: .72rem; color: var(--text-faint); animation: sp-rise .6s ease .9s both; }

  /* uscita a iride */
  .sp.sp-out { animation: sp-iris .66s cubic-bezier(.7, 0, .2, 1) forwards; pointer-events: none; }
  .sp.sp-out .sp-center { animation: sp-shrink .66s cubic-bezier(.7, 0, .2, 1) forwards; }

  @keyframes sp-glow-in { from { opacity: 0; } }
  @keyframes sp-spin { from { transform: rotate(-210deg); } }
  @keyframes sp-draw-thin  { from { stroke-dasharray: 0 326.73; opacity: 0; } 15% { opacity: 1; } }
  @keyframes sp-draw-thick { from { stroke-dasharray: 0 326.73; opacity: 0; } 15% { opacity: 1; } }
  @keyframes sp-ripple { 0% { opacity: .38; transform: scale(.7); } 100% { opacity: 0; transform: scale(2.1); } }
  @keyframes sp-letter { from { opacity: 0; transform: translateY(.55em); filter: blur(7px); } }
  @keyframes sp-rise { from { opacity: 0; transform: translateY(8px); } }
  @keyframes sp-fill { from { transform: scaleX(0); } }
  @keyframes sp-iris { to { clip-path: circle(0% at 50% 46%); } }
  @keyframes sp-shrink { to { transform: translateY(-2vh) scale(.82); opacity: 0; } }
  @keyframes sp-fade { to { opacity: 0; visibility: hidden; } }

  @media (prefers-reduced-motion: reduce) {
    .sp *, .sp *::before, .sp *::after { animation: none !important; filter: none !important; }
    .sp.sp-out { animation: sp-fade .3s ease forwards !important; clip-path: none; }
    .sp.sp-out .sp-center { animation: none !important; }
    .sp-ripple { display: none; }
  }
</style>
<noscript><style>.sp { display: none; }</style></noscript>

<div id="splash-screen" class="sp" role="status" aria-label="Caricamento di CiulloTracker">
  <div class="sp-glow" aria-hidden="true"></div>
  <div class="sp-center">
    <div class="sp-logo" aria-hidden="true">
      <span class="sp-ripple"></span>
      <svg viewBox="0 0 192 192" focusable="false">
        <g class="sp-ring">
          <circle class="sp-arc sp-arc-thin"  cx="96" cy="96" r="52" transform="rotate(-88 96 96)"/>
          <circle class="sp-arc sp-arc-thick" cx="96" cy="96" r="52" transform="rotate(36 96 96)"/>
        </g>
      </svg>
    </div>
    <h1 class="sp-word" aria-label="CiulloTracker">
      <span class="sp-a" aria-hidden="true"><% 'Ciullo'.split('').forEach(function (c, i) { %><span style="--i:<%= i %>"><%= c %></span><% }); %></span><span class="sp-b" aria-hidden="true"><% 'Tracker'.split('').forEach(function (c, i) { %><span style="--i:<%= i + 6 %>"><%= c %></span><% }); %></span>
    </h1>
    <p class="sp-tag" id="sp-tag">Le finanze di famiglia</p>
  </div>
  <div class="sp-bar" aria-hidden="true"><i></i></div>
  <div class="sp-hint" aria-hidden="true">Tocca per entrare</div>
</div>

<script nonce="<%= cspNonce %>">
  (function () {
    var splash = document.getElementById('splash-screen');
    if (!splash) return;
    var styleEl = document.getElementById('sp-style');
    var root = document.documentElement;

    // Mostrato al massimo una volta ogni 3 ore, altrimenti sparisce subito.
    var KEY = 'ciullo-tracker-splash-shown-at';
    var INTERVAL = 3 * 60 * 60 * 1000;
    var last = 0;
    try { last = Number(localStorage.getItem(KEY)); } catch (e) { last = 0; }
    if (last && Date.now() - last < INTERVAL) {
      splash.remove();
      if (styleEl) styleEl.remove();
      return;
    }
    try { localStorage.setItem(KEY, String(Date.now())); } catch (e) { /* ignorato */ }

    // Saluto in base all'ora
    var h = new Date().getHours();
    var greet = h < 5 ? 'Buonanotte' : h < 12 ? 'Buongiorno' : h < 18 ? 'Buon pomeriggio' : 'Buonasera';
    var tag = document.getElementById('sp-tag');
    if (tag) tag.textContent = greet + ' \u00B7 le finanze di famiglia';

    root.classList.add('sp-lock');

    var closed = false;
    var minDone = false;
    var loaded = document.readyState === 'complete';

    function close() {
      if (closed) return;
      closed = true;
      splash.classList.add('sp-out');
      setTimeout(function () {
        splash.remove();
        if (styleEl) styleEl.remove();
        root.classList.remove('sp-lock');
      }, 720);
    }
    function tryClose() { if (minDone && loaded) close(); }

    // Chiude quando l'animazione è finita E la pagina è pronta (mai oltre 3,4 s).
    setTimeout(function () { minDone = true; tryClose(); }, 1750);
    if (!loaded) window.addEventListener('load', function () { loaded = true; tryClose(); }, { once: true });
    setTimeout(close, 3400);

    splash.addEventListener('click', close);
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape' || e.key === 'Enter') close(); });
  })();
</script>
