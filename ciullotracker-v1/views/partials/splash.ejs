<div id="splash-screen" class="splash-screen">
  <div class="splash-mark" aria-hidden="true"></div>
  <h1 class="splash-title">CiulloTracker</h1>
  <div class="splash-rule" aria-hidden="true"></div>
</div>

<script>
  (function () {
    var splash = document.getElementById('splash-screen');
    var skipBtn = document.getElementById('splash-skip');
    if (!splash) return;

    var splashStorageKey = 'ciullo-tracker-splash-shown-at';
    var splashInterval = 3 * 60 * 60 * 1000;
    var lastShown = 0;

    try {
      lastShown = Number(localStorage.getItem(splashStorageKey));
    } catch (e) {
      lastShown = 0;
    }

    if (lastShown && Date.now() - lastShown < splashInterval) {
      splash.remove();
      return;
    }

    try {
      localStorage.setItem(splashStorageKey, String(Date.now()));
    } catch (e) {
      /* ignorato */
    }

    function hideSplash() {
      splash.style.animation = 'splash-fadeout 0.5s cubic-bezier(0.16, 1, 0.3, 1) forwards';
    }

    if (skipBtn) {
      skipBtn.addEventListener('click', hideSplash);
    }

    setTimeout(hideSplash, 1800);
  })();
</script>
