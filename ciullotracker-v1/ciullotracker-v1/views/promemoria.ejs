<!DOCTYPE html>
<html lang="it">
<head>
  <%- include('partials/head', { title: 'Promemoria Pagamenti · CiulloTracker' }) %>
</head>
<body>
  <%- include('partials/splash') %>
  <div class="app-shell">
    <%- include('partials/nav', { user: user, active: 'promemoria' }) %>

    <main class="main-content">
      <div class="page-title">Promemoria Pagamenti</div>
      <div class="page-subtitle">Tieni traccia di scadenze, bollette e pagamenti ricorrenti</div>

      <!-- Actions -->
      <div class="page-actions">
        <button class="btn btn-primary" id="btn-add">+ Aggiungi</button>
        <button class="btn btn-danger" id="btn-delete-all">Elimina tutti</button>
      </div>

      <!-- Tabella -->
      <div class="table-wrap">
        <table class="promemoria-table">
          <thead>
            <tr>
              <th>Periodo</th>
              <th>Descrizione</th>
              <th>Importo</th>
              <th>Scadenza</th>
              <th>Note</th>
              <th>Azioni</th>
            </tr>
          </thead>
          <tbody id="table-body">
            <% if (!promemoria || promemoria.length === 0) { %>
              <tr>
                <td colspan="6" class="empty-state">
                  <div style="display: flex; flex-direction: column; align-items: center; gap: 12px;">
                    <span>Nessun promemoria registrato.</span>
                    <button class="btn btn-primary" id="btn-add-empty">Aggiungi il primo</button>
                  </div>
                </td>
              </tr>
            <% } else { %>
              <% promemoria.forEach(function(p) { %>
                <tr data-id="<%= p.id %>">
                  <td><strong><%= p.periodo %></strong></td>
                  <td><%= p.descrizione %></td>
                  <td class="badge-importo">€ <%= parseFloat(p.importo).toFixed(2) %></td>
                  <td><%= p.scadenza ? new Date(p.scadenza).toLocaleDateString('it-IT') : '—' %></td>
                  <td style="max-width: 150px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;" title="<%= p.note || '' %>">
                    <%= p.note || '—' %>
                  </td>
                  <td>
                    <div class="action-buttons">
                      <button class="btn btn-primary btn-sm btn-edit" data-id="<%= p.id %>">Mod</button>
                      <button class="btn btn-danger btn-sm btn-delete" data-id="<%= p.id %>">Elim</button>
                    </div>
                  </td>
                </tr>
              <% }); %>
            <% } %>
          </tbody>
        </table>
      </div>
    </main>
  </div>

  <!-- MODAL per aggiungere/modificare -->
  <div id="modal" class="modal-overlay">
    <div class="modal-content">
      <h3 id="modal-title">Aggiungi Promemoria</h3>
      <form id="modal-form">
        <input type="hidden" id="edit-id" name="id" value="">

        <div class="field">
          <label for="periodo">Periodo *</label>
          <input type="text" id="periodo" name="periodo" class="input" 
                 placeholder="es. Gennaio-Marzo, 2024, Q1" required>
        </div>

        <div class="field">
          <label for="descrizione">Descrizione *</label>
          <input type="text" id="descrizione" name="descrizione" class="input" 
                 placeholder="es. Tari, Bolletta luce, Assicurazione" required>
        </div>

        <div class="field-row">
          <div class="field">
            <label for="importo">Importo (€)</label>
            <input type="number" id="importo" name="importo" class="input" 
                   placeholder="0.00" step="0.01" min="0">
          </div>
          <div class="field">
            <label for="scadenza">Scadenza</label>
            <input type="date" id="scadenza" name="scadenza" class="input">
          </div>
        </div>

        <div class="field">
          <label for="note">Note</label>
          <input type="text" id="note" name="note" class="input" 
                 placeholder="Eventuali note aggiuntive">
        </div>

        <div class="modal-actions">
          <button type="button" class="btn btn-secondary" id="modal-cancel">Annulla</button>
          <button type="submit" class="btn btn-primary" id="modal-submit">Salva</button>
        </div>
      </form>
    </div>
  </div>

  <script>
    // ============================================================
    //  PROMEMORIA - CRUD COMPLETO
    // ============================================================

    document.addEventListener('DOMContentLoaded', function() {

      // ---------- REFERENZE ----------
      const modal = document.getElementById('modal');
      const modalTitle = document.getElementById('modal-title');
      const modalForm = document.getElementById('modal-form');
      const editId = document.getElementById('edit-id');
      const periodo = document.getElementById('periodo');
      const descrizione = document.getElementById('descrizione');
      const importo = document.getElementById('importo');
      const scadenza = document.getElementById('scadenza');
      const note = document.getElementById('note');
      const modalCancel = document.getElementById('modal-cancel');
      const modalSubmit = document.getElementById('modal-submit');
      const tableBody = document.getElementById('table-body');
      const csrfToken = decodeURIComponent(document.cookie.split('; ').find(row => row.startsWith('x-csrf-token='))?.split('=')[1] || '');

      // ---------- TOAST ----------
      function showToast(message, type) {
        const existing = document.querySelector('.toast-notification');
        if (existing) existing.remove();

        const toast = document.createElement('div');
        toast.className = 'toast-notification ' + type;
        toast.textContent = message;
        document.body.appendChild(toast);

        setTimeout(() => {
          toast.classList.add('fade-out');
          setTimeout(() => toast.remove(), 300);
        }, 3000);
      }

      // ---------- MODAL ----------
      function openModal(data) {
        if (data) {
          modalTitle.textContent = 'Modifica Promemoria';
          editId.value = data.id || '';
          periodo.value = data.periodo || '';
          descrizione.value = data.descrizione || '';
          importo.value = data.importo || '';
          scadenza.value = data.scadenza ? data.scadenza.split('T')[0] : '';
          note.value = data.note || '';
          modalSubmit.textContent = 'Aggiorna';
        } else {
          modalTitle.textContent = 'Aggiungi Promemoria';
          editId.value = '';
          periodo.value = '';
          descrizione.value = '';
          importo.value = '';
          scadenza.value = '';
          note.value = '';
          modalSubmit.textContent = 'Salva';
        }
        modal.classList.add('active');
        descrizione.focus();
      }

      function closeModal() {
        modal.classList.remove('active');
      }

      // Apri modale per nuovo
      document.getElementById('btn-add').addEventListener('click', () => openModal(null));
      const addEmptyButton = document.getElementById('btn-add-empty');
      if (addEmptyButton) {
        addEmptyButton.addEventListener('click', () => openModal(null));
      }

      // Annulla
      modalCancel.addEventListener('click', closeModal);
      modal.addEventListener('click', function(e) {
        if (e.target === modal) closeModal();
      });
      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape' && modal.classList.contains('active')) closeModal();
      });

      // ---------- SALVA (CREATE / UPDATE) ----------
      modalForm.addEventListener('submit', async function(e) {
        e.preventDefault();

        const data = {
          id: editId.value,
          periodo: periodo.value.trim(),
          descrizione: descrizione.value.trim(),
          importo: importo.value,
          scadenza: scadenza.value || null,
          note: note.value.trim()
        };

        if (!data.descrizione || !data.periodo) {
          showToast('Descrizione e periodo sono obbligatori', 'error');
          return;
        }

        try {
          const response = await fetch('/promemoria/api/save', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrfToken },
            body: JSON.stringify(data)
          });

          const result = await response.json();

          if (!result.success) {
            showToast('Errore: ' + (result.error || 'Salvataggio fallito'), 'error');
            return;
          }

          showToast('Promemoria salvato con successo', 'success');
          closeModal();
          // Ricarica la pagina per aggiornare la tabella
          window.location.reload();

        } catch (error) {
          console.error('Errore:', error);
          showToast('Errore: ' + error.message, 'error');
        }
      });

      // ---------- CARICA PER MODIFICA ----------
      document.querySelectorAll('.btn-edit').forEach(function(btn) {
        btn.addEventListener('click', async function() {
          const id = this.dataset.id;
          try {
            const response = await fetch('/promemoria/api/get/' + id);
            const result = await response.json();
            if (result.success) {
              openModal(result.promemoria);
            } else {
              showToast('Errore: ' + result.error, 'error');
            }
          } catch (error) {
            showToast('Errore: ' + error.message, 'error');
          }
        });
      });

      // ---------- ELIMINA SINGOLO ----------
      document.querySelectorAll('.btn-delete').forEach(function(btn) {
        btn.addEventListener('click', async function() {
          const id = this.dataset.id;
          if (!confirm('Eliminare questo promemoria?')) return;

          try {
            const response = await fetch('/promemoria/api/delete/' + id, {
              method: 'DELETE', headers: { 'X-CSRF-Token': csrfToken }
            });
            const result = await response.json();
            if (result.success) {
              showToast('Promemoria eliminato', 'success');
              window.location.reload();
            } else {
              showToast('Errore: ' + result.error, 'error');
            }
          } catch (error) {
            showToast('Errore: ' + error.message, 'error');
          }
        });
      });

      // ---------- ELIMINA TUTTI ----------
      document.getElementById('btn-delete-all').addEventListener('click', async function() {
        if (!confirm('Eliminare TUTTI i promemoria? Questa operazione non è reversibile.')) return;

        try {
          const response = await fetch('/promemoria/api/delete-all', {
            method: 'DELETE', headers: { 'X-CSRF-Token': csrfToken }
          });
          const result = await response.json();
          if (result.success) {
            showToast('Tutti i promemoria eliminati', 'success');
            window.location.reload();
          } else {
            showToast('Errore: ' + result.error, 'error');
          }
        } catch (error) {
          showToast('Errore: ' + error.message, 'error');
        }
      });

    });
  </script>

</body>
</html>